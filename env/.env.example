# Copy to .env (repo root). Never commit .env.
# Fill in only the lines for your assistant.

# Models: the group agrees on one fixed model per assistant. Do not use "auto" or "default".
CLAUDE_MODEL=
CODEX_MODEL=gpt-6-luna
GEMINI_MODEL=
OPENCODE_MODEL=deepseek-v4.1-flash-free

# Claude: API key, or a subscription token from `claude setup-token`.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Codex: API key, or path to auth.json after `codex login` (ChatGPT plan), usually ~/.codex/auth.json.
OPENAI_API_KEY=
CODEX_AUTH_FILE=

# Gemini: API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenCode: the free models need no key.
