tchEvent(new w.Event('input',{bubbles:true})); await wait(30);\n  const wb=d.querySelector('[data-waitlist]'); wb.click(); await wait(30);\n  total+=await check(dom,'catalog waitlist state');\n  dom.window.close();\n }\n {\n  const {dom}=await load('registration.html'); const d=dom.window.document; const w=dom.window;\n  d.getElementById('student-name').value=''; d.getElementById('student-id').value='12'; d.getElementById('student-email').value='bad'; d.getElementById('course-select').value='';\n  d.getElementById('registration-form').dispatchEvent(new w.Event('submit',{bubbles:true,cancelable:true})); await wait(50);\n  total+=await check(dom,'registration error state');\n  // make valid and open dialog\n  d.getElementById('student-name').value='Jordan Ellis'; d.getElementById('student-id').value='20458731'; d.getElementById('student-email').value='jordan.ellis@northbridge.edu';\n  const sel=d.getElementById('course-select'); sel.value=Array.from(sel.options).find(o=>o.value&&!o.disabled).value;\n  d.getElementById('registration-form').dispatchEvent(new w.Event('submit',{bubbles:true,cancelable:true})); await wait(50);\n  total+=await check(dom,'registration dialog open');\n  dom.window.close();\n }\n {\n  const {dom}=await load('profile.html'); const d=dom.window.document; const w=dom.window;\n  d.getElementById('profile-student-id').value='abc'; d.getElementById('profile-form').dispatchEvent(new w.Event('submit',{bubbles:true,cancelable:true})); await wait(30);\n  total+=await check(dom,'profile error state');\n  dom.window.close();\n }\n console.log('TOTAL',total); process.exit(total?1:0);\n})().catch(e=>{console.error(e);process.exit(1);});\nEOF" action.permission=* action.action=allow action.pattern=*
