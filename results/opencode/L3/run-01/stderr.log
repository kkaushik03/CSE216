timestamp=2026-10-31T01:38:07.314Z level=INFO run=7374fb7f message=evaluated permission=bash pattern="node - <<'EOF'\nfunction lum(hex){let c=hex.replace('#','');if(c.length===3)c=c.split('').map(x=>x+x).join('');const rgb=[0,2,4].map(i=>parseInt(c.slice(i,i+2),16)/255).map(v=>v<=0.03928?v/12.92:Math.pow((v+0.055)/1.055,2.4));return 0.2126*rgb[0]+0.7152*rgb[1]+0.0722*rgb[2];}\nfunction ratio(a,b){const l1=lum(a),l2=lum(b);return ((Math.max(l1,l2)+0.05)/(Math.min(l1,l2)+0.05)).toFixed(2);}\nconst pairs=[\n['ink on white','#1f2937','#ffffff'],['muted on white','#4b5563','#ffffff'],['muted on tint','#4b5563','#f5f3ff'],['muted on teal tint','#4b5563','#f0fdfa'],['body on white','#374151','#ffffff'],\n['white on purple700','#ffffff','#5b21b6'],['white on purple600','#ffffff','#6d28d9'],['white on purple800','#ffffff','#4c1d95'],['white on teal700','#ffffff','#0f766e'],['white on red700','#ffffff','#991b1b'],\n['purple800 on purple100','#4c1d95','#ede9fe'],['blue800 on blue100','#1e3a8a','#dbeafe'],['teal800 on cyan100','#155e75','#cffafe'],['green800 on green100','#14532d','#dcfce7'],['orange800 on orange100','#7c2d12','#ffedd5'],['pink800 on pink100','#831843','#fce7f3'],['fuchsia900 on fuchsia100','#701a75','#fae8ff'],['amber800 on amber100','#78350f','#fef3c7'],\n['green800 on green100b','#166534','#dcfce7'],['amber800 on amber100b','#92400e','#fef3c7'],['red800 on red100','#991b1b','#fee2e2'],\n['error text on white','#991b1b','#ffffff'],['error text on errorbg','#991b1b','#fef2f2'],['red800 on errorbg','#7f1d1d','#fef2f2'],\n['yellow on purple950','#fde68a','#2e1065'],['yellow on teal900','#134e4a','#fde68a'],['footer text on purple950','#e0e7ff','#2e1065'],['footer text on teal900','#e0e7ff','#134e4a'],['white on purple950','#ffffff','#2e1065'],['white on teal900','#ffffff','#134e4a'],\n['border gray on white','#6b7280','#ffffff'],['secondary border on white','#7c3aed','#ffffff'],['focus on white','#1d4ed8','#ffffff'],['focus on tint','#1d4ed8','#f5f3ff'],\n['purple800 on purple50','#4c1d95','#f5f3ff'],['purple700 on white','#5b21b6','#ffffff'],['amber on cta?','#fde68a','#4a2c7a']\n];\nfor(const [n,a,b] of pairs) console.log(ratio(a,b).padStart(6), n);\nEOF" action.permission=* action.action=allow action.pattern=*
