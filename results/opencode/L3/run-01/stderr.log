h===0,errors.join('|'));\n    dom.window.close();\n  }\n  {\n    const {dom,errors}=await load('courses.html?q=CSE%20340'); const d=dom.window.document;\n    ck('catalog q prefill',d.getElementById('course-search').value==='CSE 340',d.getElementById('course-search').value);\n    ck('catalog q filters to 1',d.querySelectorAll('#course-list article').length===1,String(d.querySelectorAll('#course-list article').length));\n    ck('no errors q',errors.length===0,errors.join('|'));\n    dom.window.close();\n  }\n  {\n    const {dom,errors}=await load('registration.html?course=PHY%20110'); const d=dom.window.document;\n    ck('registration preselect from url',d.getElementById('course-select').value==='PHY 110',d.getElementById('course-select').value);\n    ck('registration preselect status',d.getElementById('registration-status').textContent.includes('is selected'),d.getElementById('registration-status').textContent);\n    ck('no errors preselect',errors.length===0,errors.join('|'));\n    dom.window.close();\n  }\n  {\n    const {dom,errors}=await load('registration.html?course=CSE%20420'); const d=dom.window.document;\n    ck('registration full course not selected',d.getElementById('course-select').value==='',d.getElementById('course-select').value);\n    ck('registration full status mentions waitlist',d.getElementById('registration-status').textContent.includes('waitlist'),d.getElementById('registration-status').textContent);\n    ck('no errors full',errors.length===0,errors.join('|'));\n    dom.window.close();\n  }\n  console.log(out.join('\\n')); console.log(fail?fail+' FAILED':'ALL PASSED'); process.exit(fail?1:0);\n})().catch(e=>{console.error(e);process.exit(1);});\nEOF" action.permission=* action.action=allow action.pattern=*
