timestamp=2026-10-31T01:36:21.517Z level=INFO run=7374fb7f message=evaluated permission=bash pattern="cat > /tmp/test.js <<'EOF'\nconst { JSDOM, VirtualConsole } = require('jsdom');\n\nconst base = 'http://127.0.0.1:8765/';\nconst results = [];\nlet failures = 0;\n\nfunction check(name, condition, detail) {\n  if (condition) {\n    results.push('PASS ' + name);\n  } else {\n    failures++;\n    results.push('FAIL ' + name + (detail ? ' :: ' + detail : ''));\n  }\n}\n\nfunction wait(ms) { return new Promise(r => setTimeout(r, ms)); }\n\nasync function loadPage(page) {\n  const errors = [];\n  const vc = new VirtualConsole();\n  vc.on('jsdomError', e => errors.push('jsdomError: ' + e.message));\n  vc.on('error', (...args) => errors.push('console.error: ' + args.join(' ')));\n  vc.on('warn', (...args) => errors.push('console.warn: ' + args.join(' ')));\n  const dom = await JSDOM.fromURL(base + page, {\n    runScripts: 'dangerously',\n    resources: 'usable',\n    pretendToBeVisual: true,\n    virtualConsole: vc,\n    beforeParse(window) {\n      window.matchMedia = window.matchMedia || function (query) {\n        return {\n          matches: false,\n          media: query,\n          onchange: null,\n          addEventListener() {},\n          removeEventListener() {},\n          addListener() {},\n          removeListener() {},\n          dispatchEvent() { return false; }\n        };\n      };\n      const proto = window.HTMLDialogElement ? window.HTMLDialogElement.prototype : window.HTMLElement.prototype;\n      proto.showModal = function () {\n        this.setAttribute('open', '');\n        this.dispatchEvent(new window.Event('open'));\n      };\n      proto.close = function () {\n        this.removeAttribute('open');\n        this.dispatchEvent(new window.Event('close'));\n      };\n    }\n  });\n  await new Promise(resolve => dom.window.addEventListener('load', resolve));\n  await wait(150);\n  return { dom, errors };\n}\n\nfunction fire(el, type, opts) {\n  el.dispatchEvent(new el.ownerDocument.defaultView.Event(type, Object.assign({ bubbles: true }, opts)));\n}\n\n(async () => {\n  // HOME\n  {\n    const { dom, errors } = await loadPage('index.html');\n    const d = dom.window.document;\n    check('home no console/jsdom errors', errors.length === 0, errors.join(' | '));\n    check('home one h1', d.querySelectorAll('h1').length === 1);\n    check('home featured cards rendered', d.querySelectorAll('#featured-courses article').length === 3, String(d.querySelectorAll('#featured-courses article').length));\n    check('home nav current page', d.querySelector('a[aria-current=\"page\"]')?.textContent.trim() === 'Home');\n    check('home skip link first focusable', d.body.querySelector('a,button,input,select,textarea')?.classList.contains('skip-link'));\n    dom.window.close();\n  }\n\n  // CATALOG\n  {\n    const { dom, errors } = await loadPage('courses.html');\n    const d = dom.window.document;\n    const w = dom.window;\n    check('catalog no console/jsdom errors', errors.length === 0, errors.join(' | '));\n    check('catalog renders 16 cards', d.querySelectorAll('#course-list article').length === 16, String(d.querySelectorAll('#course-list article').length));\n    check('catalog status initial', d.getElementById('catalog-status').textContent.includes('16 of 16'), d.getElementById('catalog-status').textContent);\n    check('catalog all filter labels present', d.querySelectorAll('.filter-bar label').length === 4);\n    const search = d.getElementById('course-search');\n    search.value = 'data';\n    fire(search, 'input');\n    check('catalog search filters', d.querySelectorAll('#course-list article').length > 0 && d.querySelectorAll('#course-list article').length < 16, String(d.querySelectorAll('#course-list article').length));\n    check('catalog search status updates', d.getElementById('catalog-status').textContent.startsWith('Showing'), d.getElementById('catalog-status').textContent);\n    search.value = 'zzzz-no-match';\n    fire(search, 'input');\n    check('catalog empty state shows', !d.getElementById('empty-state').hidden);\n    check('catalog list hidden when empty', d.getElementById('course-list').hidden);\n    fire(d.getElementById('empty-clear'), 'click');\n    check('catalog clear restores 16', d.querySelectorAll('#course-list article').length === 16, String(d.querySelectorAll('#course-list article').length));\n    check('catalog clear resets search', search.value === '');\n    const waitBtn = d.querySelector('[data-waitlist]');\n    check('catalog waitlist button present for full course', !!waitBtn, waitBtn ? waitBtn.textContent : 'none');\n    if (waitBtn) {\n      fire(waitBtn, 'click');\n      check('catalog waitlist status announced', d.getElementById('catalog-status').textContent.includes('joined the waitlist'), d.getElementById('catalog-status').textContent);\n      check('catalog waitlist badge appears', !!d.querySelector('.badge-status.waitlisted'));\n    }\n    check('catalog nav current page', d.querySelector('a[aria-current=\"page\"]')?.textContent.trim() === 'Courses');\n    dom.window.close();\n  }\n\n  // REGISTRATION\n  {\n    const { dom, errors } = await loadPage('registration.html');\n    const d = dom.window.document;\n    const w = dom.window;\n    check('registration no console/jsdom errors', errors.length === 0, errors.join(' | '));\n    check('registration table seeded', d.querySelectorAll('#registered-body tr').length === 2, String(d.querySelectorAll('#registered-body tr').length));\n    check('registration prefilled name', d.getElementById('student-name').value.length > 0);\n    check('registration prefilled student id', /^\\d{8}$/.test(d.getElementById('student-id').value), d.getElementById('student-id').value);\n    check('registration select has optgroups', d.querySelectorAll('#course-select optgroup').length > 0);\n    check('registration registered course options disabled', Array.from(d.querySelectorAll('#course-select option')).some(o => o.disabled));\n\n    // invalid submit\n    d.getElementById('student-name').value = '';\n    d.getElementById('student-id').value = '12';\n    d.getElementById('student-email').value = 'bad';\n    d.getElementById('course-select').value = '';\n    fire(d.getElementById('registration-form'), 'submit');\n    await wait(30);\n    check('registration error summary visible', !d.getElementById('form-errors').hidden);\n    check('registration summary has 4 links', d.querySelectorAll('#form-error-list a').length === 4, String(d.querySelectorAll('#form-error-list a').length));\n    check('registration summary focused', d.activeElement === d.getElementById('form-errors'), d.activeElement ? d.activeElement.id : 'none');\n    check('registration aria-invalid set', d.getElementById('student-name').getAttribute('aria-invalid') === 'true');\n\n    // valid submit\n    d.getElementById('student-name').value = 'Jordan Ellis';\n    d.getElementById('student-id').value = '20458731';\n    d.getElementById('student-email').value = 'jordan.ellis@northbridge.edu';\n    const select = d.getElementById('course-select');\n    const validOption = Array.from(select.options).find(o => o.value && !o.disabled);\n    select.value = validOption.value;\n    fire(select, 'change');\n    fire(d.getElementById('registration-form'), 'submit');\n    await wait(30);\n    const dialog = d.getElementById('confirm-dialog');\n    check('registration dialog opens', dialog.hasAttribute('open'));\n    check('registration dialog focus on cancel', d.activeElement === d.getElementById('confirm-cancel'), d.activeElement ? d.activeElement.id : 'none');\n    check('registration dialog details populated', d.getElementById('confirm-details').children.length >= 4, String(d.getElementById('confirm-details').children.length));\n    fire(d.getElementById('confirm-submit'), 'click');\n    await wait(50);\n    check('registration table now 3 rows', d.querySelectorAll('#registered-body tr').length === 3, String(d.querySelectorAll('#registered-body tr').length));\n    check('registration success status', d.getElementById('registration-status').textContent.includes('Registration saved'), d.getElementById('registration-status').textContent);\n    check('registration dialog closed', !dialog.hasAttribute('open'));\n\n    // drop flow\n    const dropBtn = d.querySelector('#registered-body [data-drop]');\n    const droppedCode = dropBtn.getAttribute('data-drop');\n    fire(dropBtn, 'click');\n    await wait(30);\n    check('drop dialog opens', dialog.hasAttribute('open'));\n    check('drop dialog title names course', d.getElementById('confirm-title').textContent.includes(droppedCode), d.getElementById('confirm-title').textContent);\n    fire(d.getElementById('confirm-submit'), 'click');\n    await wait(80);\n    check('drop table now 2 rows', d.querySelectorAll('#registered-body tr').length === 2, String(d.querySelectorAll('#registered-body tr').length));\n    check('drop status announced', d.getElementById('registration-status').textContent.includes('dropped'), d.getElementById('registration-status').textContent);\n    check('drop focus moves to heading', d.activeElement === d.getElementById('registered-heading'), d.activeElement ? d.activeElement.id : 'none');\n    check('registration nav current page', d.querySelector('a[aria-current=\"page\"]')?.textContent.trim() === 'Registration');\n    dom.window.close();\n  }\n\n  // PROFILE\n  {\n    const { dom, errors } = await loadPage('profile.html');\n    const d = dom.window.document;\n    check('profile no console/jsdom errors', errors.length === 0, errors.join(' | '));\n    check('profile prefilled name', d.getElementById('profile-name').value.length > 0);\n    check('profile summary courses', d.getElementById('summary-courses').textContent === '2', d.getElementById('summary-courses').textContent);\n    check('profile summary credits', d.getElementById('summary-credits').textContent === '7', d.getElementById('summary-credits').textContent);\n    d.getElementById('profile-name').value = 'Avery Johnson';\n    fire(d.getElementById('profile-form'), 'submit');\n    await wait(30);\n    check('profile save status', d.getElementById('profile-status').textContent.includes('Profile saved'), d.getElementById('profile-status').textContent);\n    check('profile nav current page', d.querySelector('a[aria-current=\"page\"]')?.textContent.trim() === 'Profile');\n    // invalid profile\n    d.getElementById('profile-student-id').value = 'abc';\n    fire(d.getElementById('profile-form'), 'submit');\n    await wait(30);\n    check('profile invalid shows field error', !d.getElementById('profile-student-id-error').hidden);\n    check('profile invalid focus first field', d.activeElement === d.getElementById('profile-student-id'), d.activeElement ? d.activeElement.id : 'none');\n    dom.window.close();\n  }\n\n  console.log(results.join('\\n'));\n  console.log('\\n' + (failures === 0 ? 'ALL CHECKS PASSED' : failures + ' CHECK(S) FAILED'));\n  process.exit(failures ? 1 : 0);\n})().catch(err => { console.error(err); process.exit(1); });\nEOF" action.permission=* action.action=allow action.pattern=*
