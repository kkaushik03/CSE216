timestamp=2026-10-31T01:38:52.013Z level=INFO run=7374fb7f message=evaluated permission=bash pattern="python3 - <<'PY'\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nclass IDs(HTMLParser):\n    def __init__(self):\n        super().__init__(); self.ids=[]; self.labels=[]; self.described=[]; self.controls=[]\n    def handle_starttag(self,tag,attrs):\n        a=dict(attrs)\n        if 'id' in a: self.ids.append(a['id'])\n        if 'for' in a: self.labels.append(a['for'])\n        if 'aria-describedby' in a: self.described += a['aria-describedby'].split()\n        if 'aria-controls' in a: self.controls += a['aria-controls'].split()\n        if 'aria-labelledby' in a: self.controls += a['aria-labelledby'].split()\nfor p in sorted(Path('.').glob('*.html')):\n    x=IDs(); x.feed(p.read_text())\n    dup=sorted({i for i in x.ids if x.ids.count(i)>1})\n    missing_labels=[f for f in x.labels if f not in x.ids]\n    missing_refs=[r for r in x.described+x.controls if r not in x.ids]\n    print(p, 'ids', len(x.ids), 'dups', dup, 'missing label targets', missing_labels, 'missing refs', missing_refs)\nPY" action.permission=* action.action=allow action.pattern=*
