timestamp=2026-10-31T01:50:26.086Z level=INFO run=58204745 message=evaluated permission=bash pattern="cat > /tmp/a11y-test/test.js <<'EOF'\nconst fs = require('fs');\nconst { JSDOM } = require('jsdom');\n\nconst html = fs.readFileSync('/work/index.html', 'utf8');\nconst appJs = fs.readFileSync('/work/app.js', 'utf8');\n\nconst errors = [];\nconst dom = new JSDOM(html, {\n  url: 'http://localhost/',\n  runScripts: 'dangerously',\n  pretendToBeVisual: true,\n  resources: 'usable'\n});\nconst { window } = dom;\nwindow.addEventListener('error', e => errors.push('error: ' + e.message));\nconst origError = window.console.error;\nwindow.console.error = (...args) => { errors.push('console.error: ' + args.join(' ')); origError(...args); };\n\nif (!window.HTMLDialogElement) {\n  window.HTMLDialogElement = function() {};\n}\nconst proto = window.HTMLDialogElement.prototype;\nproto.showModal = function () { this.setAttribute('open', ''); this.open = true; };\nproto.close = function () { this.removeAttribute('open'); this.open = false; this.dispatchEvent(new window.Event('close')); };\n\nwindow.eval(appJs);\n\nfunction assert(cond, msg) {\n  if (!cond) { console.log('FAIL: ' + msg); process.exitCode = 1; }\n  else console.log('PASS: ' + msg);\n}\nfunction $(sel) { return window.document.querySelector(sel); }\nfunction $$(sel) { return [...window.document.querySelectorAll(sel)]; }\nfunction nav(hash) {\n  window.location.hash = hash;\n  window.dispatchEvent(new window.HashChangeEvent('hashchange'));\n}\nfunction fire(el, type) {\n  el.dispatchEvent(new window.Event(type, { bubbles: true }));\n}\n\nassert($('#main-content h1').textContent.includes('Plan your next semester'), 'home renders');\nassert($('.nav-list a[aria-current=\"page\"]').dataset.route === '#/home', 'home nav current');\nassert(window.document.title.startsWith('Home'), 'home title');\n\nnav('#/catalog');\nassert($('#main-content h1').textContent === 'Course catalog', 'catalog renders');\nassert($('.nav-list a[aria-current=\"page\"]').dataset.route === '#/catalog', 'catalog nav current');\nassert($$('#course-list > li').length === 16, '16 course cards');\nassert($('#catalog-count').textContent.includes('16'), 'count shows 16');\nassert($('#course-list article h3'), 'cards have headings');\n\nconst search = $('#course-search');\nsearch.value = 'biology';\nfire(search, 'input');\nassert($$('#course-list > li').length === 2, 'search filters to biology courses');\nassert($('#catalog-count').textContent.startsWith('2 courses'), 'search count announces 2');\nsearch.value = 'zzzz';\nfire(search, 'input');\nassert($('.empty-state'), 'empty state shown');\nfire($('[data-action=\"reset-filters\"]'), 'click');\nassert($$('#course-list > li').length === 16, 'reset restores 16');\n\nconst dept = $('#dept-filter');\ndept.value = 'CSE';\nfire(dept, 'change');\nassert($$('#course-list > li').length === 3, 'department filter CSE = 3');\ndept.value = 'all'; fire(dept, 'change');\nconst avail = $('#availability-filter');\navail.value = 'full'; fire(avail, 'change');\nassert($$('#course-list > li').length === 2, 'full filter = 2');\nfire($('[data-action=\"reset-filters\"]'), 'click');\n\nconst registerBtn = $('[data-action=\"register-course\"][data-course-id=\"CSE320\"]');\nassert(registerBtn, 'register button exists');\nregisterBtn.click();\nnav('#/register');\nassert($('#main-content h1').textContent === 'Course registration', 'registration renders after card action');\nassert($('#course').value === 'CSE320', 'course preselected from card');\nassert($('#full-name').value === 'Jordan Ellis', 'name prefilled');\nassert($('#email').value === 'jordan.ellis@northgate.edu', 'email prefilled');\nassert($('#student-id').value === '20261457', 'student ID prefilled');\n\n// invalid submit\n$('#student-id').value = '123';\n$('#registration-form').dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\nassert($('#student-id').getAttribute('aria-invalid') === 'true', 'invalid student ID marked');\nassert(!$('#reg-error-summary').hidden, 'error summary shown');\nassert($('#reg-error-summary').querySelectorAll('a').length === 1, 'error summary has one link');\nassert(window.document.activeElement === $('#reg-error-summary'), 'focus moved to error summary');\n\n// error link focuses field\n$('#reg-error-summary a').click();\nassert(window.document.activeElement === $('#student-id'), 'error link focuses field');\n\n// fix and submit\n$('#student-id').value = '20261457';\nfire($('#student-id'), 'input');\nassert($('#student-id').getAttribute('aria-invalid') === null, 'error cleared on input');\n$('#registration-form').dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\nassert($('#confirm-dialog').open, 'confirmation dialog opens');\nassert(window.document.activeElement === $('#dialog-cancel'), 'focus on cancel');\nassert($('#dialog-description').textContent.includes('CSE 320'), 'dialog describes course');\n\n// cancel\n$('#dialog-cancel').click();\nassert(!$('#confirm-dialog').open, 'dialog closes on cancel');\n\n// submit again and confirm\n$('#registration-form').dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\n$('#dialog-confirm').click();\nassert(!$('#confirm-dialog').open, 'dialog closes on confirm');\nassert($('.flash').textContent.includes('Registration saved'), 'flash confirms save');\nassert($('#registration-form'), 'registration page re-rendered');\nassert($$('#registration-courses-heading ~ .table-scroll tbody tr').length === 4, 'table now has 4 courses');\n\nnav('#/profile');\nassert($('#main-content h1').textContent === 'Student profile', 'profile renders');\nassert($$('.table-scroll tbody tr').length === 4, 'profile table has 4 rows');\nassert($('.table-scroll').getAttribute('tabindex') === '0', 'table region focusable');\nassert($('.table-scroll').getAttribute('role') === 'region', 'table region role');\nassert($('.table-scroll caption'), 'table caption present');\nassert($('.table-scroll th[scope=\"col\"]'), 'column headers scoped');\nassert($('.table-scroll th[scope=\"row\"]'), 'row headers scoped');\nassert($('.table-scroll button[aria-label=\"Drop CSE 320\"]'), 'drop button named with course');\n\n// drop flow\n$('.table-scroll button[aria-label=\"Drop CSE 320\"]').click();\nassert($('#confirm-dialog').open, 'drop dialog opens');\nassert(window.document.activeElement === $('#dialog-cancel'), 'drop dialog focuses cancel');\n$('#dialog-confirm').click();\nassert($('.flash').textContent.includes('dropped'), 'drop flash shown');\nassert($$('.table-scroll tbody tr').length === 3, 'table back to 3 rows');\n\n// nav all routes\n['#/home', '#/catalog', '#/register', '#/profile'].forEach(h => {\n  nav(h);\n  assert($('#main-content h1'), 'route ' + h + ' has h1');\n  assert($('.nav-list a[aria-current=\"page\"]').dataset.route === h, 'route ' + h + ' nav current');\n});\n\n// headings sanity on each route\n['#/home', '#/catalog', '#/register', '#/profile'].forEach(h => {\n  nav(h);\n  const levels = $$('#main-content h1, #main-content h2, #main-content h3').map(x => Number(x.tagName[1]));\n  let ok = levels[0] === 1;\n  for (let i = 1; i < levels.length; i++) if (levels[i] > levels[i-1] + 1) ok = false;\n  assert(ok, 'heading order on ' + h + ': ' + levels.join(','));\n});\n\nassert(errors.length === 0, 'no JS console errors: ' + errors.join(' | '));\nconsole.log('DONE');\nEOF" action.permission=* action.action=allow action.pattern=*
