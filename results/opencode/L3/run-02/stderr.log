timestamp=2026-10-31T02:00:13.323Z level=INFO run=58204745 message=evaluated permission=bash pattern="cat > /tmp/a11y-test/extra-test.js <<'EOF'\nconst { chromium } = require('playwright');\n(async () => {\n  const browser = await chromium.launch();\n  const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });\n  const errs = [];\n  page.on('pageerror', e => errs.push(e.message));\n  page.on('console', m => { if (m.type() === 'error') errs.push(m.text()); });\n  let fail = 0;\n  const check = (c, m) => { console.log((c ? 'PASS: ' : 'FAIL: ') + m); if (!c) fail++; };\n\n  for (const route of ['#/home', '#/catalog', '#/register', '#/profile']) {\n    await page.goto('http://localhost:8765/index.html' + route);\n    await page.waitForTimeout(250);\n    await page.addStyleTag({ content: `\n      * { line-height: 1.5 !important; letter-spacing: 0.12em !important; word-spacing: 0.16em !important; }\n      p { margin-bottom: 2em !important; }\n    `});\n    await page.waitForTimeout(100);\n    const overflow = await page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth + 1);\n    check(overflow, 'text spacing no horizontal overflow ' + route);\n  }\n\n  // Mobile menu closes when focus leaves nav\n  await page.setViewportSize({ width: 320, height: 700 });\n  await page.goto('http://localhost:8765/index.html#/catalog');\n  await page.waitForTimeout(250);\n  await page.locator('#menu-toggle').click();\n  await page.waitForTimeout(100);\n  await page.locator('.nav-list a[data-route=\"#/catalog\"]').focus();\n  await page.keyboard.press('Tab'); // last nav link? catalog is 2nd; tab to Registration\n  await page.keyboard.press('Tab');\n  await page.keyboard.press('Tab'); // Student profile\n  await page.keyboard.press('Tab'); // leave nav -> main search\n  await page.waitForTimeout(100);\n  const expanded = await page.locator('#menu-toggle').getAttribute('aria-expanded');\n  check(expanded === 'false', 'menu closes when focus leaves nav');\n  const active = await page.evaluate(() => ({ tag: document.activeElement.tagName, id: document.activeElement.id }));\n  check(active.id === 'course-search', 'focus continues into main after menu closes: ' + JSON.stringify(active));\n\n  // Mobile registration page overflow\n  await page.goto('http://localhost:8765/index.html#/register');\n  await page.waitForTimeout(250);\n  check(await page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth + 1), 'register no horizontal overflow at 320');\n  await page.screenshot({ path: '/tmp/a11y-test/register-mobile.png', fullPage: false });\n\n  check(errs.length === 0, 'no JS errors: ' + errs.join(' | '));\n  console.log(fail === 0 ? 'EXTRA TESTS PASSED' : fail + ' FAILURES');\n  await browser.close();\n})();\nEOF" action.permission=* action.action=allow action.pattern=*
