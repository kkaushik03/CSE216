timestamp=2026-10-31T01:52:50.867Z level=INFO run=58204745 message=evaluated permission=bash pattern="cat > /tmp/a11y-test/browser-test.js <<'EOF'\nconst { chromium } = require('playwright');\n\n(async () => {\n  const browser = await chromium.launch();\n  const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });\n  const consoleErrors = [];\n  const pageErrors = [];\n  page.on('console', msg => { if (msg.type() === 'error') consoleErrors.push(msg.text()); });\n  page.on('pageerror', err => pageErrors.push(err.message));\n\n  let failures = 0;\n  function check(cond, msg) {\n    if (!cond) { console.log('FAIL: ' + msg); failures++; } else console.log('PASS: ' + msg);\n  }\n  async function activeInfo() {\n    return page.evaluate(() => {\n      const el = document.activeElement;\n      return el ? { tag: el.tagName, id: el.id, text: (el.textContent || '').trim().slice(0, 60) } : null;\n    });\n  }\n\n  await page.goto('http://localhost:8765/index.html');\n  await page.waitForTimeout(300);\n  check(await page.locator('h1').innerText() === 'Plan your next semester with confidence', 'home loads');\n  check(await page.locator('.nav-list a[aria-current=\"page\"]').getAttribute('data-route') === '#/home', 'home aria-current');\n  check(await page.title() === 'Home | Northgate University Course Registration', 'home title');\n\n  // Skip link first focusable\n  await page.keyboard.press('Tab');\n  let a = await activeInfo();\n  check(a && a.text.includes('Skip to main content'), 'skip link is first focusable');\n  await page.keyboard.press('Enter');\n  await page.waitForTimeout(100);\n  a = await activeInfo();\n  check(a && a.tag === 'MAIN', 'skip link focuses main');\n\n  // Navigate catalog\n  await page.locator('.nav-list a[data-route=\"#/catalog\"]').click();\n  await page.waitForTimeout(150);\n  check(await page.locator('h1').innerText() === 'Course catalog', 'catalog loads');\n  check((await activeInfo()).tag === 'H1', 'catalog focus moved to h1');\n  check(await page.locator('#course-list > li').count() === 16, '16 course cards');\n  check((await page.locator('#catalog-count').innerText()).includes('16'), 'count 16');\n\n  // Search\n  await page.locator('#course-search').fill('biology');\n  await page.waitForTimeout(150);\n  check(await page.locator('#course-list > li').count() === 2, 'search biology -> 2');\n  check((await page.locator('#catalog-count').innerText()).startsWith('2 courses'), 'search count updated');\n  check((await page.locator('#app-status').innerText()).includes('2 courses'), 'search announced in status region');\n  await page.locator('[data-action=\"reset-filters\"]').click();\n  await page.waitForTimeout(100);\n  check(await page.locator('#course-list > li').count() === 16, 'reset filters');\n\n  // Filters\n  await page.selectOption('#dept-filter', 'CSE');\n  await page.waitForTimeout(100);\n  check(await page.locator('#course-list > li').count() === 3, 'dept filter CSE');\n  await page.selectOption('#level-filter', '400');\n  await page.waitForTimeout(100);\n  check(await page.locator('#course-list > li').count() === 1, 'level 400 with CSE');\n  await page.selectOption('#availability-filter', 'full');\n  await page.waitForTimeout(100);\n  check(await page.locator('#course-list > li').count() === 1, 'full CSE 400 course');\n  await page.locator('[data-action=\"reset-filters\"]').click();\n\n  // Register from card\n  await page.locator('button[aria-label=\"Register for CSE 320\"]').click();\n  await page.waitForTimeout(200);\n  check(await page.locator('h1').innerText() === 'Course registration', 'registration loads');\n  check(await page.locator('#course').inputValue() === 'CSE320', 'course preselected');\n  check(await page.locator('#full-name').inputValue() === 'Jordan Ellis', 'name prefilled');\n  check(await page.locator('#email').inputValue() === 'jordan.ellis@northgate.edu', 'email prefilled');\n  check(await page.locator('#student-id').inputValue() === '20261457', 'student ID prefilled');\n  check(await page.locator('#program').inputValue() === 'BSc Computer Science', 'program prefilled');\n  check(await page.locator('input[name=\"contact\"]:checked').getAttribute('value') === 'Email', 'contact prefilled');\n\n  // Invalid submit\n  await page.locator('#student-id').fill('123');\n  await page.locator('button[type=\"submit\"]').click();\n  await page.waitForTimeout(150);\n  check(await page.locator('#student-id').getAttribute('aria-invalid') === 'true', 'invalid field marked');\n  check(await page.locator('#reg-error-summary').isVisible(), 'error summary visible');\n  check((await activeInfo()).id === 'reg-error-summary', 'focus on error summary');\n  const errText = await page.locator('#student-id-error').innerText();\n  check(errText.includes('8 digits') && errText.includes('how') === false && errText.includes('20261457'), 'error text explains fix');\n  await page.locator('#reg-error-summary a').click();\n  await page.waitForTimeout(100);\n  check((await activeInfo()).id === 'student-id', 'error link focuses field');\n\n  // Fix and submit -> dialog\n  await page.locator('#student-id').fill('20261457');\n  await page.locator('button[type=\"submit\"]').click();\n  await page.waitForTimeout(200);\n  check(await page.locator('#confirm-dialog').getAttribute('open') !== null, 'dialog opens');\n  check((await activeInfo()).id === 'dialog-cancel', 'dialog focuses Cancel');\n  check((await page.locator('#dialog-description').innerText()).includes('CSE 320'), 'dialog content names course');\n  const dialogName = await page.locator('#confirm-dialog').getAttribute('aria-labelledby');\n  check(dialogName === 'dialog-title', 'dialog labelled by title');\n\n  // Cancel with Escape returns focus\n  await page.keyboard.press('Escape');\n  await page.waitForTimeout(150);\n  check(await page.locator('#confirm-dialog').getAttribute('open') === null, 'Escape closes dialog');\n  check((await activeInfo()).tag === 'BUTTON' && (await activeInfo()).text === 'Review registration', 'focus returns to opener');\n\n  // Confirm\n  await page.locator('button[type=\"submit\"]').click();\n  await page.waitForTimeout(150);\n  await page.locator('#dialog-confirm').click();\n  await page.waitForTimeout(250);\n  check(await page.locator('#confirm-dialog').getAttribute('open') === null, 'confirm closes dialog');\n  check((await page.locator('.flash').innerText()).includes('Registration saved'), 'save flash shown');\n  check((await page.locator('#app-status').innerText()).includes('Registration saved'), 'save announced');\n  check((await activeInfo()).tag === 'H1', 'focus moved to new view h1');\n  check(await page.locator('.table-scroll tbody tr').count() === 4, 'registered table has 4 rows');\n\n  // Profile\n  await page.locator('.nav-list a[data-route=\"#/profile\"]').click();\n  await page.waitForTimeout(150);\n  check(await page.locator('h1').innerText() === 'Student profile', 'profile loads');\n  check(await page.locator('.table-scroll tbody tr').count() === 4, 'profile table 4 rows');\n  check(await page.locator('.table-scroll').getAttribute('tabindex') === '0', 'table region focusable');\n  check(await page.locator('.table-scroll').getAttribute('role') === 'region', 'table region role');\n  check(await page.locator('.table-scroll caption').count() === 1, 'table caption');\n  check(await page.locator('.table-scroll th[scope=\"col\"]').count() === 6, '6 column headers');\n  check(await page.locator('.table-scroll th[scope=\"row\"]').count() === 4, '4 row headers');\n  check(await page.locator('button[aria-label=\"Drop CSE 320\"]').count() === 1, 'drop button named with course');\n\n  // Drop dialog\n  await page.locator('button[aria-label=\"Drop CSE 320\"]').click();\n  await page.waitForTimeout(150);\n  check((await activeInfo()).id === 'dialog-cancel', 'drop dialog focuses Cancel');\n  await page.locator('#dialog-confirm').click();\n  await page.waitForTimeout(200);\n  check((await page.locator('.flash').innerText()).includes('dropped'), 'drop flash shown');\n  check(await page.locator('.table-scroll tbody tr').count() === 3, 'profile table back to 3');\n\n  // Focus indicator computed style\n  const focusStyle = await page.evaluate(() => {\n    const btn = document.querySelector('.nav-list a[data-route=\"#/home\"]');\n    btn.focus();\n    const cs = getComputedStyle(btn);\n    return { outlineWidth: cs.outlineWidth, outlineStyle: cs.outlineStyle, boxShadow: cs.boxShadow };\n  });\n  check(focusStyle.outlineWidth !== '0px' && focusStyle.outlineStyle !== 'none', 'focus outline present');\n  check(focusStyle.boxShadow !== 'none', 'focus ring present');\n\n  // Mobile\n  await page.setViewportSize({ width: 320, height: 700 });\n  await page.goto('http://localhost:8765/index.html#/catalog');\n  await page.waitForTimeout(300);\n  const overflow = await page.evaluate(() => ({\n    doc: document.documentElement.scrollWidth,\n    client: document.documentElement.clientWidth,\n    body: document.body.scrollWidth\n  }));\n  check(overflow.doc <= overflow.client + 1, 'no horizontal page overflow at 320px: ' + JSON.stringify(overflow));\n  check(await page.locator('#menu-toggle').isVisible(), 'menu toggle visible at 320px');\n  check(await page.locator('#menu-toggle').getAttribute('aria-expanded') === 'false', 'menu starts collapsed');\n  check(await page.locator('#primary-nav').isHidden(), 'nav hidden when collapsed');\n  await page.locator('#menu-toggle').click();\n  await page.waitForTimeout(100);\n  check(await page.locator('#menu-toggle').getAttribute('aria-expanded') === 'true', 'menu expands');\n  check(await page.locator('#primary-nav').isVisible(), 'nav visible when expanded');\n  await page.keyboard.press('Escape');\n  await page.waitForTimeout(100);\n  check(await page.locator('#menu-toggle').getAttribute('aria-expanded') === 'false', 'Escape collapses menu');\n  check((await activeInfo()).id === 'menu-toggle', 'Escape returns focus to toggle');\n\n  // Mobile table scroll region\n  await page.goto('http://localhost:8765/index.html#/profile');\n  await page.waitForTimeout(300);\n  const tableInfo = await page.evaluate(() => {\n    const wrap = document.querySelector('.table-scroll');\n    return { scrollWidth: wrap.scrollWidth, clientWidth: wrap.clientWidth, overflowX: getComputedStyle(wrap).overflowX };\n  });\n  check(tableInfo.scrollWidth > tableInfo.clientWidth, 'table scrolls inside container at 320px');\n  check(tableInfo.overflowX === 'auto', 'table wrapper overflow auto');\n  const mobileOverflow = await page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth + 1);\n  check(mobileOverflow, 'profile has no horizontal page overflow at 320px');\n\n  // 200% zoom approximation: 640 CSS px viewport with device scale? use setViewportSize 640\n  await page.setViewportSize({ width: 640, height: 700 });\n  await page.waitForTimeout(100);\n  check(await page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth + 1), 'no overflow at 640px');\n\n  check(consoleErrors.length === 0, 'no console errors: ' + consoleErrors.join(' | '));\n  check(pageErrors.length === 0, 'no page errors: ' + pageErrors.join(' | '));\n\n  await page.setViewportSize({ width: 1280, height: 900 });\n  await page.goto('http://localhost:8765/index.html#/home');\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: '/tmp/a11y-test/home.png', fullPage: true });\n  await page.goto('http://localhost:8765/index.html#/catalog');\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: '/tmp/a11y-test/catalog.png', fullPage: true });\n  await page.goto('http://localhost:8765/index.html#/register');\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: '/tmp/a11y-test/register.png', fullPage: true });\n  await page.goto('http://localhost:8765/index.html#/profile');\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: '/tmp/a11y-test/profile.png', fullPage: true });\n  await page.setViewportSize({ width: 320, height: 700 });\n  await page.goto('http://localhost:8765/index.html#/catalog');\n  await page.waitForTimeout(300);\n  await page.screenshot({ path: '/tmp/a11y-test/catalog-mobile.png', fullPage: true });\n\n  console.log(failures === 0 ? 'ALL BROWSER TESTS PASSED' : failures + ' FAILURES');\n  await browser.close();\n})();\nEOF" action.permission=* action.action=allow action.pattern=*
