timestamp=2026-10-31T01:54:41.565Z level=INFO run=58204745 message=evaluated permission=bash pattern="cat > /tmp/a11y-test/debug.js <<'EOF'\nconst { chromium } = require('playwright');\n(async () => {\n  const browser = await chromium.launch();\n  const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });\n  page.on('console', m => console.log('CONSOLE', m.type(), m.text()));\n  page.on('pageerror', e => console.log('PAGEERROR', e.message));\n  await page.goto('http://localhost:8765/index.html#/catalog');\n  await page.waitForTimeout(300);\n  await page.locator('#course-search').fill('biology');\n  await page.waitForTimeout(400);\n  console.log('status textContent:', JSON.stringify(await page.locator('#app-status').textContent()));\n  console.log('status innerText:', JSON.stringify(await page.locator('#app-status').innerText()));\n  console.log('status visible:', await page.locator('#app-status').isVisible());\n  console.log('count:', JSON.stringify(await page.locator('#catalog-count').innerText()));\n  await page.locator('[data-action=\"reset-filters\"]').click();\n  await page.locator('button[aria-label=\"Register for CSE 320\"]').click();\n  await page.waitForTimeout(500);\n  console.log('url:', page.url());\n  console.log('h1 count:', await page.locator('h1').count());\n  console.log('h1 textContent:', JSON.stringify(await page.locator('h1').textContent()));\n  console.log('h1 innerText:', JSON.stringify(await page.locator('h1').innerText()));\n  console.log('course value:', await page.locator('#course').inputValue());\n  console.log('status now:', JSON.stringify(await page.locator('#app-status').textContent()));\n\n  await page.locator('#student-id').fill('123');\n  await page.locator('button[type=\"submit\"]').click();\n  await page.waitForTimeout(300);\n  console.log('summary visible:', await page.locator('#reg-error-summary').isVisible());\n  console.log('summary hidden attr:', await page.locator('#reg-error-summary').getAttribute('hidden'));\n  console.log('summary box:', await page.locator('#reg-error-summary').boundingBox());\n  console.log('error text:', JSON.stringify(await page.locator('#student-id-error').innerText()));\n  console.log('error textContent:', JSON.stringify(await page.locator('#student-id-error').textContent()));\n  console.log('error hidden:', await page.locator('#student-id-error').getAttribute('hidden'));\n  console.log('error visible:', await page.locator('#student-id-error').isVisible());\n  console.log('link count:', await page.locator('#reg-error-summary a').count());\n  console.log('link visible:', await page.locator('#reg-error-summary a').isVisible());\n  console.log('link box:', await page.locator('#reg-error-summary a').boundingBox());\n  console.log('link style:', await page.locator('#reg-error-summary a').evaluate(el => {\n    const cs = getComputedStyle(el); const r = el.getBoundingClientRect();\n    return {display: cs.display, visibility: cs.visibility, opacity: cs.opacity, width: r.width, height: r.height, color: cs.color, bg: cs.backgroundColor, rect: r.toJSON()};\n  }));\n  console.log('ul style:', await page.locator('#reg-error-summary ul').evaluate(el => {\n    const cs = getComputedStyle(el); const r = el.getBoundingClientRect();\n    return {display: cs.display, visibility: cs.visibility, width: r.width, height: r.height, rect: r.toJSON()};\n  }));\n  await page.screenshot({path: '/tmp/a11y-test/debug-register.png', fullPage: true});\n  await browser.close();\n})();\nEOF" action.permission=* action.action=allow action.pattern=*
