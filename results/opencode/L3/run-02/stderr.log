timestamp=2026-10-31T01:57:34.382Z level=INFO run=58204745 message=evaluated permission=bash pattern="cat > /tmp/a11y-test/axe-test.js <<'EOF'\nconst { chromium } = require('playwright');\nconst path = require('path');\nconst axePath = require.resolve('axe-core/axe.min.js');\n\n(async () => {\n  const browser = await chromium.launch();\n  const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });\n  const errors = [];\n  page.on('console', m => { if (m.type() === 'error') errors.push(m.text()); });\n  page.on('pageerror', e => errors.push(e.message));\n\n  async function scan(label) {\n    await page.addScriptTag({ path: axePath });\n    const result = await page.evaluate(async () => {\n      return await axe.run(document, {\n        runOnly: { type: 'tag', values: ['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa', 'wcag22aa', 'best-practice'] }\n      });\n    });\n    const violations = result.violations.filter(v => v.impact !== 'minor' || true);\n    console.log('\\n=== ' + label + ' ===');\n    if (violations.length === 0) console.log('No violations');\n    for (const v of violations) {\n      console.log('[' + v.impact + '] ' + v.id + ': ' + v.help);\n      for (const node of v.nodes) {\n        console.log('  target: ' + node.target.join(' '));\n        console.log('  ' + node.failureSummary.replace(/\\n/g, '\\n  '));\n      }\n    }\n    return violations.length;\n  }\n\n  let total = 0;\n  for (const route of ['#/home', '#/catalog', '#/register', '#/profile']) {\n    await page.goto('http://localhost:8765/index.html' + route);\n    await page.waitForTimeout(400);\n    total += await scan(route);\n  }\n\n  // Dialog state\n  await page.goto('http://localhost:8765/index.html#/register');\n  await page.waitForTimeout(300);\n  await page.selectOption('#course', 'CSE320');\n  await page.locator('button[type=\"submit\"]').click();\n  await page.waitForTimeout(200);\n  total += await scan('registration dialog');\n\n  // Error state\n  await page.goto('http://localhost:8765/index.html#/register');\n  await page.waitForTimeout(300);\n  await page.locator('#student-id').fill('abc');\n  await page.locator('button[type=\"submit\"]').click();\n  await page.waitForTimeout(200);\n  total += await scan('registration errors');\n\n  // Mobile menu open\n  await page.setViewportSize({ width: 320, height: 700 });\n  await page.goto('http://localhost:8765/index.html#/catalog');\n  await page.waitForTimeout(300);\n  await page.locator('#menu-toggle').click();\n  await page.waitForTimeout(100);\n  total += await scan('mobile menu open');\n\n  console.log('\\nTOTAL VIOLATIONS: ' + total);\n  console.log('JS ERRORS: ' + (errors.length ? errors.join(' | ') : 'none'));\n  await browser.close();\n})();\nEOF" action.permission=* action.action=allow action.pattern=*
