timestamp=2026-11-01T00:40:09.339Z level=INFO run=7034ae1b message=evaluated permission=bash pattern="cat > /tmp/nbu-test/browser-test.js <<'JS'\nconst { chromium } = require('playwright');\nconst fs = require('fs');\nconst axeSource = fs.readFileSync(require.resolve('axe-core/axe.min.js'), 'utf8');\nconst BASE = 'http://127.0.0.1:8123/';\n\nfunction assert(cond, msg) {\n  if (!cond) throw new Error('ASSERT FAILED: ' + msg);\n}\n\nasync function checkPage(browser, url, label, viewport) {\n  const page = await browser.newPage({ viewport: viewport || { width: 1280, height: 900 } });\n  const errors = [];\n  page.on('console', (msg) => { if (msg.type() === 'error') errors.push('console: ' + msg.text()); });\n  page.on('pageerror', (err) => errors.push('pageerror: ' + err.message));\n  await page.goto(BASE + url, { waitUntil: 'networkidle' });\n  await page.addScriptTag({ content: axeSource });\n  const results = await page.evaluate(async () => {\n    return await axe.run(document, {\n      runOnly: { type: 'tag', values: ['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa', 'wcag22aa', 'best-practice'] }\n    });\n  });\n  if (results.violations.length) {\n    console.log('\\nAXE ' + label + ' violations:');\n    for (const v of results.violations) {\n      console.log('-', v.id, '|', v.impact, '|', v.help);\n      for (const n of v.nodes.slice(0, 6)) {\n        console.log('   ', n.target.join(' '), '::', n.failureSummary.replace(/\\n/g, ' ').slice(0, 350));\n      }\n    }\n  } else {\n    console.log('AXE ' + label + ': no violations');\n  }\n  assert(errors.length === 0, label + ' console errors: ' + errors.join(' | '));\n  return page;\n}\n\n(async () => {\n  const browser = await chromium.launch();\n\n  // Desktop pages\n  for (const [file, label] of [['index.html','home'],['courses.html','catalog'],['register.html','register'],['profile.html','profile']]) {\n    const page = await checkPage(browser, file, label);\n    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);\n    assert(overflow <= 1, label + ' desktop horizontal overflow ' + overflow);\n    if (label === 'home') {\n      await page.screenshot({ path: '/tmp/nbu-test/home-desktop.png', fullPage: true });\n    }\n    if (label === 'catalog') {\n      await page.screenshot({ path: '/tmp/nbu-test/catalog-desktop.png', fullPage: true });\n    }\n    if (label === 'register') {\n      await page.screenshot({ path: '/tmp/nbu-test/register-desktop.png', fullPage: true });\n    }\n    if (label === 'profile') {\n      await page.screenshot({ path: '/tmp/nbu-test/profile-desktop.png', fullPage: true });\n    }\n    await page.close();\n  }\n\n  // Mobile viewport (320px)\n  for (const [file, label] of [['index.html','home'],['courses.html','catalog'],['register.html','register'],['profile.html','profile']]) {\n    const page = await checkPage(browser, file, label + '-320', { width: 320, height: 720 });\n    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);\n    assert(overflow <= 1, label + ' 320px horizontal overflow ' + overflow);\n    if (label === 'home') {\n      await page.screenshot({ path: '/tmp/nbu-test/home-320.png', fullPage: true });\n    }\n    if (label === 'register') {\n      await page.screenshot({ path: '/tmp/nbu-test/register-320.png', fullPage: true });\n    }\n    if (label === 'profile') {\n      await page.screenshot({ path: '/tmp/nbu-test/profile-320.png', fullPage: true });\n    }\n    await page.close();\n  }\n\n  // Mobile menu behaviour\n  {\n    const page = await browser.newPage({ viewport: { width: 320, height: 720 } });\n    await page.goto(BASE + 'index.html', { waitUntil: 'networkidle' });\n    const toggle = page.locator('.nav-toggle');\n    assert(await toggle.isVisible(), 'mobile toggle visible');\n    await toggle.click();\n    assert(await toggle.getAttribute('aria-expanded') === 'true', 'mobile menu expands');\n    assert(await page.locator('#primary-nav').isVisible(), 'mobile nav visible');\n    await page.keyboard.press('Escape');\n    assert(await toggle.getAttribute('aria-expanded') === 'false', 'mobile menu collapses on escape');\n    assert(await toggle.evaluate(el => document.activeElement === el), 'escape returns focus to toggle');\n    await page.close();\n  }\n\n  // Catalog real interactions\n  {\n    const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });\n    await page.goto(BASE + 'courses.html?q=calculus', { waitUntil: 'networkidle' });\n    assert(await page.locator('#course-search').inputValue() === 'calculus', 'query param prefills search');\n    assert(await page.locator('#course-grid .course-card').count() === 1, 'search query result');\n    await page.locator('#reset-filters').click();\n    assert(await page.locator('#course-grid .course-card').count() === 18, 'reset shows 18');\n    await page.locator('#filter-availability').selectOption('full');\n    assert(await page.locator('#course-grid .course-card').count() === 2, 'full courses count 2');\n    await page.locator('#filter-department').selectOption('Computer Science');\n    assert(await page.locator('#course-grid .course-card').count() === 1, 'full CSE course count 1');\n    const status = await page.locator('#results-status').textContent();\n    assert(status.includes('1 of 18'), 'status count after filters');\n    await page.close();\n  }\n\n  // Registration flow and persistence\n  {\n    const context = await browser.newContext({ viewport: { width: 1280, height: 900 } });\n    const page = await context.newPage();\n    const errors = [];\n    page.on('console', (msg) => { if (msg.type() === 'error') errors.push(msg.text()); });\n    page.on('pageerror', (err) => errors.push(err.message));\n    await page.goto(BASE + 'register.html', { waitUntil: 'networkidle' });\n    await page.locator('#reg-name').fill('');\n    await page.locator('button[type=\"submit\"]').click();\n    assert(await page.locator('#error-summary').isVisible(), 'error summary visible');\n    assert(await page.evaluate(() => document.activeElement.id) === 'error-summary', 'error summary focused');\n    assert(await page.locator('#reg-name').getAttribute('aria-invalid') === 'true', 'name invalid');\n    await page.locator('#reg-name').fill('Jordan Rivera');\n    await page.locator('#reg-course').selectOption('CSE 216');\n    await page.locator('button[type=\"submit\"]').click();\n    assert(await page.locator('#confirm-dialog').isVisible(), 'confirm dialog visible');\n    assert(await page.evaluate(() => document.activeElement.id) === 'confirm-cancel', 'cancel initially focused');\n    await page.screenshot({ path: '/tmp/nbu-test/register-dialog.png' });\n    await page.keyboard.press('Escape');\n    assert(!(await page.locator('#confirm-dialog').isVisible()), 'escape closes dialog');\n    assert(await page.evaluate(() => document.activeElement.id) === 'confirm-submit' || await page.evaluate(() => document.activeElement.type === 'submit'), 'focus returns to opener after escape');\n    await page.locator('button[type=\"submit\"]').click();\n    await page.locator('#confirm-submit').click();\n    await page.waitForTimeout(100);\n    assert(await page.locator('#reg-status').textContent().then(t => t.includes('CSE 216')), 'success status');\n    await page.goto(BASE + 'profile.html', { waitUntil: 'networkidle' });\n    assert(await page.locator('#registered-tbody tr').count() === 3, 'registration persisted to profile');\n    const rowsText = await page.locator('#registered-tbody').textContent();\n    assert(rowsText.includes('CSE 216'), 'CSE 216 in profile');\n    assert(errors.length === 0, 'registration console errors: ' + errors.join(' | '));\n    await context.close();\n  }\n\n  // Profile update and drop\n  {\n    const page = await browser.newPage({ viewport: { width: 1280, height: 900 } });\n    await page.goto(BASE + 'profile.html', { waitUntil: 'networkidle' });\n    await page.locator('#profile-name-input').fill('Jordan A. Rivera');\n    await page.locator('#profile-form button[type=\"submit\"]').click();\n    assert(await page.locator('#profile-name').textContent() === 'Jordan A. Rivera', 'profile displays saved name');\n    assert(await page.locator('#profile-status').textContent().then(t => t.includes('saved')), 'profile status');\n    const drop = page.locator('[data-drop=\"PSY 101\"]');\n    await drop.click();\n    assert(await page.locator('#drop-dialog').isVisible(), 'drop dialog visible');\n    assert(await page.evaluate(() => document.activeElement.id) === 'drop-cancel', 'drop cancel focused');\n    await page.locator('#drop-confirm').click();\n    await page.waitForTimeout(100);\n    assert(await page.locator('#registered-tbody tr').count() === 1, 'drop removes row');\n    assert(await page.evaluate(() => document.activeElement.id) === 'registered-heading', 'focus after drop to heading');\n    assert(await page.locator('#registered-status').textContent().then(t => t.includes('PSY 101')), 'drop status');\n    await page.close();\n  }\n\n  // 200% zoom / large text-ish check (CSS zoom to emulate)\n  {\n    const page = await browser.newPage({ viewport: { width: 640, height: 800 } });\n    await page.goto(BASE + 'courses.html', { waitUntil: 'networkidle' });\n    await page.evaluate(() => { document.documentElement.style.fontSize = '200%'; });\n    await page.waitForTimeout(100);\n    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);\n    assert(overflow <= 1, '200% text zoom horizontal overflow ' + overflow);\n    await page.close();\n  }\n\n  await browser.close();\n  console.log('BROWSER TESTS PASSED');\n})().catch((e) => {\n  console.error(e.stack || e);\n  process.exit(1);\n});\nJS" action.permission=* action.action=allow action.pattern=*
