timestamp=2026-11-01T00:33:09.837Z level=INFO run=7034ae1b message=evaluated permission=bash pattern="python3 - <<'PY'\ndef lum(h):\n    h=h.lstrip('#')\n    r,g,b=(int(h[i:i+2],16)/255 for i in (0,2,4))\n    def f(c): return c/12.92 if c<=0.03928 else ((c+0.055)/1.055)**2.4\n    return 0.2126*f(r)+0.7152*f(g)+0.0722*f(b)\ndef ratio(a,b):\n    l1,l2=sorted((lum(a),lum(b)),reverse=True)\n    return (l1+0.05)/(l2+0.05)\npairs=[\n('#FFFFFF','#5B21B6'),('#FFFFFF','#3B0764'),('#FDE047','#3B0764'),('#1E1B2E','#F8F5FF'),\n('#4B4560','#FFFFFF'),('#6D28D9','#FFFFFF'),('#166534','#DCFCE7'),('#991B1B','#FEE2E2'),\n('#92400E','#FEF3C7'),('#0E7490','#ECFEFF'),('#9D174D','#FCE7F3'),('#374151','#E5E7EB'),\n('#3B0764','#FDE047'),('#FFFFFF','#9D174D'),('#FFFFFF','#0E7490'),('#FFFFFF','#4C1D95'),\n('#FFFFFF','#BE185D'),('#1E1B2E','#FDE68A'),('#6D28D9','#F8F5FF'),('#FFFFFF','#166534'),\n('#FDE047','#2E1065'),('#FFFFFF','#2E1065'),('#FFFFFF','#B45309'),('#FFFFFF','#047857'),\n]\nfor a,b in pairs:\n    print(f'{a} on {b}: {ratio(a,b):.2f}')\nPY" action.permission=* action.action=allow action.pattern=*
