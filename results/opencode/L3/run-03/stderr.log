timestamp=2026-11-01T00:38:03.909Z level=INFO run=7034ae1b message=evaluated permission=bash pattern="cat > /tmp/nbu-test/test.js <<'JS'\nconst { JSDOM, VirtualConsole } = require('jsdom');\nconst fs = require('fs');\nconst axeSource = fs.readFileSync(require.resolve('axe-core/axe.min.js'), 'utf8');\n\nconst BASE = 'http://127.0.0.1:8123/';\n\nasync function loadPage(page, seed) {\n  const errors = [];\n  const vc = new VirtualConsole();\n  vc.on('jsdomError', (e) => errors.push('jsdomError: ' + e.message));\n  vc.on('error', (...args) => errors.push('console.error: ' + args.join(' ')));\n  vc.on('warn', (...args) => { /* console.log('warn', ...args) */ });\n  const dom = await JSDOM.fromURL(BASE + page, {\n    resources: 'usable',\n    runScripts: 'dangerously',\n    pretendToBeVisual: true,\n    virtualConsole: vc,\n    beforeParse(window) {\n      const proto = window.HTMLDialogElement && window.HTMLDialogElement.prototype;\n      if (proto) {\n        proto.showModal = function () {\n          this.setAttribute('open', '');\n          this.__jsdomModal = true;\n        };\n        proto.close = function () {\n          if (!this.hasAttribute('open')) return;\n          this.removeAttribute('open');\n          this.dispatchEvent(new window.Event('close'));\n        };\n      }\n      if (seed) {\n        try { window.localStorage.setItem('nbu-registration-v1', JSON.stringify(seed)); } catch (e) { errors.push('seed: ' + e.message); }\n      }\n    }\n  });\n  await new Promise((resolve) => {\n    if (dom.window.document.readyState === 'complete') resolve();\n    else dom.window.addEventListener('load', resolve, { once: true });\n  });\n  await new Promise((r) => setTimeout(r, 150));\n  return { dom, window: dom.window, document: dom.window.document, errors };\n}\n\nfunction assert(cond, msg) {\n  if (!cond) throw new Error('ASSERT FAILED: ' + msg);\n}\n\nasync function runAxe(name, window) {\n  window.eval(axeSource);\n  const results = await window.axe.run(window.document, {\n    runOnly: { type: 'tag', values: ['wcag2a', 'wcag2aa', 'wcag21a', 'wcag21aa', 'wcag22aa', 'best-practice'] }\n  });\n  if (results.violations.length) {\n    console.log('\\nAXE ' + name + ' violations:');\n    for (const v of results.violations) {\n      console.log('-', v.id, '|', v.impact, '|', v.help);\n      for (const n of v.nodes.slice(0, 4)) console.log('   ', n.target.join(' '), '::', n.failureSummary.replace(/\\n/g, ' ').slice(0, 240));\n    }\n  } else {\n    console.log('AXE ' + name + ': no violations');\n  }\n}\n\n(async () => {\n  // HOME\n  {\n    const { window, document, errors } = await loadPage('index.html');\n    assert(document.querySelectorAll('h1').length === 1, 'home has one h1');\n    assert(document.querySelectorAll('#featured-courses .course-card').length === 3, 'home has 3 featured cards');\n    assert(document.querySelectorAll('nav[aria-label=\"Main\"] .nav-link').length === 4, 'nav has 4 links');\n    assert(document.querySelector('.nav-link[aria-current=\"page\"]').textContent.trim() === 'Home', 'home current nav');\n    const toggle = document.querySelector('.nav-toggle');\n    toggle.click();\n    assert(toggle.getAttribute('aria-expanded') === 'true', 'menu opens');\n    assert(document.querySelector('#primary-nav').classList.contains('is-open'), 'menu class open');\n    document.dispatchEvent(new window.KeyboardEvent('keydown', { key: 'Escape', bubbles: true }));\n    assert(toggle.getAttribute('aria-expanded') === 'false', 'escape closes menu');\n    assert(document.activeElement === toggle, 'escape returns focus to toggle');\n    console.log('HOME OK, errors:', errors);\n    await runAxe('home', window);\n  }\n\n  // CATALOG\n  {\n    const { window, document, errors } = await loadPage('courses.html');\n    assert(document.querySelectorAll('#course-grid .course-card').length === 18, 'catalog 18 cards');\n    const input = document.querySelector('#course-search');\n    input.value = 'calculus';\n    input.dispatchEvent(new window.Event('input', { bubbles: true }));\n    await new Promise((r) => setTimeout(r, 300));\n    assert(document.querySelectorAll('#course-grid .course-card').length === 1, 'search calculus returns 1');\n    assert(document.querySelector('#results-status').textContent.includes('1 of 18'), 'status count updates');\n    input.value = '';\n    const dept = document.querySelector('#filter-department');\n    dept.value = 'Computer Science';\n    dept.dispatchEvent(new window.Event('change', { bubbles: true }));\n    await new Promise((r) => setTimeout(r, 50));\n    assert(document.querySelectorAll('#course-grid .course-card').length === 4, 'CSE dept returns 4');\n    const avail = document.querySelector('#filter-availability');\n    avail.value = 'full';\n    avail.dispatchEvent(new window.Event('change', { bubbles: true }));\n    await new Promise((r) => setTimeout(r, 50));\n    assert(document.querySelectorAll('#course-grid .course-card').length === 1, 'full CSE returns 1');\n    document.querySelector('#reset-filters').click();\n    await new Promise((r) => setTimeout(r, 50));\n    assert(document.querySelectorAll('#course-grid .course-card').length === 18, 'reset returns 18');\n    console.log('CATALOG OK, errors:', errors);\n    await runAxe('catalog', window);\n  }\n\n  // REGISTER\n  {\n    const { window, document, errors } = await loadPage('register.html');\n    assert(document.querySelector('#reg-name').value === 'Jordan Rivera', 'registration prefills name');\n    assert(document.querySelector('#reg-email').value === 'jordan.rivera@northbridge.edu', 'registration prefills email');\n    // validation\n    const name = document.querySelector('#reg-name');\n    name.value = '';\n    document.querySelector('#registration-form').dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\n    await new Promise((r) => setTimeout(r, 20));\n    assert(!document.querySelector('#error-summary').hidden, 'error summary shows');\n    assert(document.activeElement === document.querySelector('#error-summary'), 'focus moves to error summary');\n    assert(document.querySelector('#reg-name').getAttribute('aria-invalid') === 'true', 'invalid name marked');\n    assert(document.querySelectorAll('#error-summary-list li').length >= 1, 'summary lists error');\n    // duplicate\n    name.value = 'Jordan Rivera';\n    name.dispatchEvent(new window.Event('input', { bubbles: true }));\n    const course = document.querySelector('#reg-course');\n    course.value = 'PSY 101';\n    course.dispatchEvent(new window.Event('change', { bubbles: true }));\n    document.querySelector('#registration-form').dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\n    await new Promise((r) => setTimeout(r, 20));\n    assert(document.querySelector('#reg-course-error').textContent.includes('already registered'), 'duplicate detected');\n    // success\n    course.value = 'CSE 216';\n    course.dispatchEvent(new window.Event('change', { bubbles: true }));\n    document.querySelector('#registration-form').dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\n    await new Promise((r) => setTimeout(r, 20));\n    const dialog = document.querySelector('#confirm-dialog');\n    assert(dialog.hasAttribute('open'), 'confirm dialog opens');\n    assert(document.activeElement === document.querySelector('#confirm-cancel'), 'cancel focused in dialog');\n    assert(document.querySelector('#confirm-summary').textContent.includes('CSE 216'), 'dialog summarizes course');\n    document.querySelector('#confirm-submit').click();\n    await new Promise((r) => setTimeout(r, 20));\n    assert(!dialog.hasAttribute('open'), 'dialog closes after confirm');\n    assert(document.querySelector('#reg-status').textContent.includes('CSE 216'), 'success status shown');\n    const saved = JSON.parse(window.localStorage.getItem('nbu-registration-v1'));\n    assert(saved.registrations.includes('CSE 216'), 'registration persisted');\n    console.log('REGISTER OK, errors:', errors);\n    await runAxe('register', window);\n  }\n\n  // PROFILE\n  {\n    const { window, document, errors } = await loadPage('profile.html');\n    assert(document.querySelectorAll('#registered-tbody tr').length === 2, 'profile table has 2 rows');\n    assert(document.querySelector('#registered-caption').textContent.includes('2 courses'), 'caption count');\n    // invalid profile save\n    const name = document.querySelector('#profile-name-input');\n    name.value = '';\n    document.querySelector('#profile-form').dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\n    await new Promise((r) => setTimeout(r, 20));\n    assert(document.activeElement === name, 'focus first invalid profile field');\n    assert(name.getAttribute('aria-invalid') === 'true', 'profile name invalid');\n    // save profile\n    name.value = 'Jordan A. Rivera';\n    name.dispatchEvent(new window.Event('input', { bubbles: true }));\n    document.querySelector('#profile-form').dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\n    await new Promise((r) => setTimeout(r, 20));\n    assert(document.querySelector('#profile-name').textContent === 'Jordan A. Rivera', 'profile display updated');\n    assert(document.querySelector('#profile-status').textContent.includes('saved'), 'profile status');\n    // drop\n    const dropButton = document.querySelector('[data-drop=\"PSY 101\"]');\n    assert(!!dropButton, 'drop button exists');\n    assert(dropButton.getAttribute('aria-label').startsWith('Drop PSY 101'), 'drop accessible name');\n    dropButton.click();\n    await new Promise((r) => setTimeout(r, 20));\n    const dd = document.querySelector('#drop-dialog');\n    assert(dd.hasAttribute('open'), 'drop dialog opens');\n    assert(document.activeElement === document.querySelector('#drop-cancel'), 'drop cancel focused');\n    assert(document.querySelector('#drop-description').textContent.includes('PSY 101'), 'drop desc course');\n    document.querySelector('#drop-confirm').click();\n    await new Promise((r) => setTimeout(r, 30));\n    assert(document.querySelectorAll('#registered-tbody tr').length === 1, 'row removed after drop');\n    assert(document.querySelector('#registered-status').textContent.includes('PSY 101'), 'drop status');\n    assert(document.activeElement === document.querySelector('#registered-heading'), 'focus moves to heading after drop');\n    console.log('PROFILE OK, errors:', errors);\n    await runAxe('profile', window);\n  }\n})().catch((e) => {\n  console.error(e.stack || e);\n  process.exit(1);\n});\nJS" action.permission=* action.action=allow action.pattern=*
