timestamp=2026-11-01T01:13:03.649Z level=INFO run=7034ae1b message=evaluated permission=bash pattern="cat > /tmp/nbu-test/state-axe.js <<'JS'\nconst { chromium } = require('playwright');\nconst fs = require('fs');\nconst axeSource = fs.readFileSync(require.resolve('axe-core/axe.min.js'), 'utf8');\nconst BASE = 'http://127.0.0.1:8123/';\nasync function axe(page, label) {\n  await page.addScriptTag({ content: axeSource });\n  const results = await page.evaluate(async () => await axe.run(document, {\n    runOnly: { type: 'tag', values: ['wcag2a','wcag2aa','wcag21a','wcag21aa','wcag22aa','best-practice'] }\n  }));\n  if (results.violations.length) {\n    console.log('\\nAXE ' + label + ' violations:');\n    for (const v of results.violations) {\n      console.log('-', v.id, '|', v.impact, '|', v.help);\n      for (const n of v.nodes.slice(0, 5)) console.log('   ', n.target.join(' '), '::', n.failureSummary.replace(/\\n/g,' ').slice(0,300));\n    }\n  } else console.log('AXE ' + label + ': no violations');\n}\n(async()=>{\n const b=await chromium.launch();\n // error state\n {\n  const p=await b.newPage({viewport:{width:1280,height:900}});\n  await p.goto(BASE+'register.html',{waitUntil:'networkidle'});\n  await p.locator('#reg-name').fill('');\n  await p.locator('button[type=submit]').click();\n  await axe(p,'register-error-state');\n  await p.close();\n }\n // dialog state\n {\n  const p=await b.newPage({viewport:{width:1280,height:900}});\n  await p.goto(BASE+'register.html',{waitUntil:'networkidle'});\n  await p.locator('#reg-course').selectOption('CSE 216');\n  await p.locator('button[type=submit]').click();\n  await axe(p,'register-confirm-dialog');\n  await p.close();\n }\n // drop dialog\n {\n  const p=await b.newPage({viewport:{width:1280,height:900}});\n  await p.goto(BASE+'profile.html',{waitUntil:'networkidle'});\n  await p.locator('[data-drop=\"PSY 101\"]').click();\n  await axe(p,'profile-drop-dialog');\n  await p.close();\n }\n // catalog empty state\n {\n  const p=await b.newPage({viewport:{width:1280,height:900}});\n  await p.goto(BASE+'courses.html',{waitUntil:'networkidle'});\n  await p.locator('#course-search').fill('zzzz-no-results');\n  await p.waitForTimeout(300);\n  await axe(p,'catalog-empty-state');\n  await p.close();\n }\n // mobile menu open\n {\n  const p=await b.newPage({viewport:{width:320,height:720}});\n  await p.goto(BASE+'index.html',{waitUntil:'networkidle'});\n  await p.locator('.nav-toggle').click();\n  await axe(p,'home-mobile-menu-open');\n  await p.close();\n }\n // empty registered state\n {\n  const p=await b.newPage({viewport:{width:1280,height:900}});\n  await p.goto(BASE+'profile.html',{waitUntil:'networkidle'});\n  await p.evaluate(()=>localStorage.setItem('nbu-registration-v1',JSON.stringify({profile:{name:'Jordan Rivera',email:'jordan.rivera@northbridge.edu',studentId:'20261408',program:'Computer Science',year:'2'},registrations:[]})));\n  await p.reload({waitUntil:'networkidle'});\n  await axe(p,'profile-empty-schedule');\n  await p.close();\n }\n await b.close();\n console.log('STATE AXE DONE');\n})().catch(e=>{console.error(e.stack||e);process.exit(1)});\nJS" action.permission=* action.action=allow action.pattern=*
