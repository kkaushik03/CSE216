timestamp=2026-10-30T00:22:08.566Z level=INFO run=01cdacec message=evaluated permission=bash pattern="cat > /tmp/prism-test/qa.cjs <<'EOF'\nconst { chromium } = require('playwright');\nconst assert = require('assert');\n(async() => {\n  const browser = await chromium.launch();\n  const errors = [];\n  const ctx = await browser.newContext({ viewport: { width: 1440, height: 1000 } });\n  const page = await ctx.newPage();\n  page.on('pageerror', e => errors.push('pageerror: '+e.message));\n  page.on('console', m => { if (m.type() === 'error') errors.push('console: '+m.text()); });\n\n  const pages = ['index.html','catalog.html','registration.html','profile.html'];\n  for (const vp of [{width:390,height:844},{width:768,height:1024},{width:1024,height:900},{width:1440,height:1000}]) {\n    await page.setViewportSize(vp);\n    for (const p of pages) {\n      await page.goto('http://127.0.0.1:4173/'+p, {waitUntil:'networkidle'});\n      const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);\n      if (overflow > 0) errors.push(`${p} overflow at ${vp.width}: ${overflow}px`);\n    }\n  }\n\n  await page.setViewportSize({width:1440,height:1000});\n  await page.goto('http://127.0.0.1:4173/index.html',{waitUntil:'networkidle'});\n  for (const href of ['catalog.html','registration.html','profile.html','index.html']) {\n    const links = await page.$$eval(`a[href=\"${href}\"]`, els => els.length);\n    assert(links > 0, 'link to '+href);\n  }\n\n  await page.click('#nav-toggle');\n  const navOpen = await page.$eval('#primary-nav', el => el.classList.contains('is-open'));\n  assert(navOpen, 'nav opens');\n  await page.setViewportSize({width:390,height:844});\n  await page.click('#nav-toggle').catch(()=>{});\n  await page.goto('http://127.0.0.1:4173/catalog.html', {waitUntil:'networkidle'});\n  await page.fill('#course-search','climate');\n  assert.strictEqual(await page.locator('#course-grid .course-card').count(), 1, 'search climate');\n  await page.click('#clear-filters');\n  assert.strictEqual(await page.locator('#course-grid .course-card').count(), 15, 'clear filters');\n  await page.fill('#course-search','design');\n  assert.strictEqual(await page.locator('#course-grid .course-card').count(), 2, 'search design');\n  await page.fill('#course-search','zzzzzz');\n  assert(await page.locator('#catalog-empty').isVisible(), 'empty state visible');\n  await page.click('#clear-filters');\n  await page.selectOption('#availability-filter','few');\n  assert.strictEqual(await page.locator('#course-grid .course-card').count(), 3, 'few seats');\n\n  await page.goto('http://127.0.0.1:4173/registration.html',{waitUntil:'networkidle'});\n  await page.selectOption('#course-select','cs310');\n  await page.click('#add-course');\n  await page.click('#review-registration');\n  assert(await page.locator('#confirmation-modal').isVisible(), 'modal visible');\n  await page.click('#confirm-registration');\n  assert((await page.locator('#modal-content').innerText()).includes(\"You're all set\"), 'success modal');\n  await page.click('#modal-actions [data-modal-close]');\n  await page.goto('http://127.0.0.1:4173/profile.html',{waitUntil:'networkidle'});\n  assert.strictEqual(await page.locator('#profile-course-body tr:not(.empty-row)').count(), 3, 'profile has new course');\n\n  for (const p of pages) {\n    await page.goto('http://127.0.0.1:4173/'+p,{waitUntil:'networkidle'});\n  }\n\n  console.log('Browser QA errors:', JSON.stringify(errors, null, 2));\n  if (errors.length) process.exitCode = 1;\n  else console.log('PASS browser QA');\n  await browser.close();\n})().catch(e => { console.error(e); process.exit(1); });\nEOF" action.permission=* action.action=allow action.pattern=*
