timestamp=2026-10-30T00:13:30.699Z level=INFO run=01cdacec message=evaluated permission=bash pattern="cat > /tmp/prism-test/visual.cjs <<'EOF'\nconst { chromium } = require('playwright');\n(async() => {\n  const browser = await chromium.launch();\n  const page = await browser.newPage({ viewport: { width: 1440, height: 1100 }, deviceScaleFactor: 1 });\n  const errors = [];\n  page.on('console', msg => { if (msg.type() === 'error') errors.push(msg.text()); });\n  page.on('pageerror', err => errors.push(err.message));\n  for (const [name, url] of [['catalog','catalog.html'],['registration','registration.html'],['profile','profile.html']]) {\n    await page.goto('http://127.0.0.1:4173/' + url, { waitUntil: 'networkidle' });\n    await page.screenshot({ path: `/tmp/prism-${name}.png`, fullPage: true });\n  }\n  await page.setViewportSize({ width: 390, height: 844 });\n  await page.goto('http://127.0.0.1:4173/index.html', { waitUntil: 'networkidle' });\n  await page.screenshot({ path: '/tmp/prism-home-mobile.png', fullPage: true });\n  await page.goto('http://127.0.0.1:4173/catalog.html', { waitUntil: 'networkidle' });\n  await page.screenshot({ path: '/tmp/prism-catalog-mobile.png', fullPage: true });\n  await page.goto('http://127.0.0.1:4173/registration.html', { waitUntil: 'networkidle' });\n  await page.screenshot({ path: '/tmp/prism-registration-mobile.png', fullPage: true });\n  console.log('errors', JSON.stringify(errors));\n  await browser.close();\n})();\nEOF" action.permission=* action.action=allow action.pattern=*
