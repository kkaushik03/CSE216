timestamp=2026-10-30T00:10:46.126Z level=INFO run=01cdacec message=evaluated permission=bash pattern="cat > /tmp/prism-test/test.cjs <<'EOF'\nconst { JSDOM, VirtualConsole } = require('jsdom');\nconst assert = require('assert');\n\nconst BASE = 'http://127.0.0.1:4173/';\nconst errors = [];\n\nasync function load(page) {\n  const virtualConsole = new VirtualConsole();\n  virtualConsole.on('jsdomError', (e) => errors.push(`${page} jsdom: ${e.message}`));\n  virtualConsole.on('error', (...args) => errors.push(`${page} console: ${args.join(' ')}`));\n  virtualConsole.on('warn', () => {});\n  const dom = await JSDOM.fromURL(BASE + page, {\n    runScripts: 'dangerously',\n    resources: 'usable',\n    pretendToBeVisual: true,\n    virtualConsole\n  });\n  await new Promise((resolve) => dom.window.addEventListener('load', resolve));\n  await new Promise((r) => setTimeout(r, 100));\n  return dom;\n}\n\nfunction click(win, el) {\n  assert(el, 'element to click must exist');\n  el.dispatchEvent(new win.MouseEvent('click', { bubbles: true, cancelable: true }));\n}\n\n(async () => {\n  {\n    const dom = await load('index.html');\n    const { document, localStorage } = dom.window;\n    assert.strictEqual(document.querySelectorAll('#faculty-grid .faculty-card').length, 6, 'faculty cards');\n    assert.strictEqual(document.querySelectorAll('#featured-grid .course-card').length, 3, 'featured cards');\n    assert(document.querySelector('#featured-grid [data-course-add]'), 'featured add button');\n    const add = document.querySelector('#featured-grid [data-course-add]');\n    click(dom.window, add);\n    assert.strictEqual(JSON.parse(localStorage.getItem('prism_plan_v1')).length, 1, 'plan count after add');\n    assert.strictEqual(document.querySelector('[data-plan-count]').textContent, '1', 'nav plan badge');\n    assert(document.querySelector('.toast'), 'toast shown');\n    assert(document.querySelector('#featured-grid .course-state--planned'), 'card state updated');\n    assert.strictEqual(document.querySelector('[data-nav=\"home\"]').getAttribute('aria-current'), 'page', 'home active');\n    console.log('PASS home interactions');\n  }\n\n  {\n    const dom = await load('catalog.html?department=Design');\n    const { document, window } = dom.window;\n    assert.strictEqual(document.querySelectorAll('#course-grid .course-card').length, 2, 'department query filters');\n    assert.strictEqual(document.querySelector('#department-filter').value, 'Design', 'department select matches query');\n    const search = document.querySelector('#course-search');\n    search.value = 'climate';\n    search.dispatchEvent(new window.Event('input', { bubbles: true }));\n    assert.strictEqual(document.querySelectorAll('#course-grid .course-card').length, 0, 'combined filter no results');\n    document.querySelector('#clear-filters').click();\n    assert.strictEqual(document.querySelectorAll('#course-grid .course-card').length, 15, 'clear filters restores all');\n    document.querySelector('#level-filter').value = '300';\n    document.querySelector('#level-filter').dispatchEvent(new window.Event('change', { bubbles: true }));\n    assert.strictEqual(document.querySelectorAll('#course-grid .course-card').length, 5, 'level filter 300');\n    const firstAdd = document.querySelector('#course-grid [data-course-add]');\n    click(window, firstAdd);\n    assert(document.querySelector('.toast'), 'catalog toast');\n    assert(document.querySelector('[data-plan-count]').textContent === '1', 'catalog plan badge');\n    console.log('PASS catalog interactions');\n  }\n\n  {\n    const dom = await load('registration.html');\n    const { document, window, localStorage } = dom.window;\n    assert.strictEqual(document.querySelectorAll('#current-enrollment-body tr:not(.empty-row)').length, 2, 'seeded enrollment rows');\n    assert.strictEqual(document.querySelector('#full-name').value, 'Jordan Avery', 'profile prefills name');\n    assert(document.querySelector('#review-registration').disabled, 'review disabled with empty plan');\n    const select = document.querySelector('#course-select');\n    select.value = 'cs310';\n    document.querySelector('#add-course').click();\n    assert.strictEqual(document.querySelectorAll('#plan-table-body tr:not(.empty-row)').length, 1, 'plan row added');\n    assert.strictEqual(document.querySelector('#plan-credits').textContent, '4', 'plan credits');\n    assert.strictEqual(document.querySelector('#plan-course-count').textContent, '1', 'plan count');\n    assert(!document.querySelector('#review-registration').disabled, 'review enabled');\n    const planBefore = JSON.parse(localStorage.getItem('prism_plan_v1'));\n    assert.deepStrictEqual(planBefore, ['cs310'], 'plan storage');\n    document.querySelector('#review-registration').click();\n    assert(!document.querySelector('#confirmation-modal').hidden, 'modal opens');\n    assert(document.querySelector('#confirm-registration'), 'confirm button exists');\n    assert(document.querySelector('#confirmation-modal').textContent.includes('CS 310'), 'modal shows course');\n    document.querySelector('#confirm-registration').click();\n    assert(document.querySelector('#modal-content').textContent.includes(\"You're all set\"), 'success view');\n    assert.strictEqual(JSON.parse(localStorage.getItem('prism_registered_v1')).length, 3, 'registration persisted');\n    assert.deepStrictEqual(JSON.parse(localStorage.getItem('prism_plan_v1')), [], 'plan cleared');\n    assert.strictEqual(document.querySelectorAll('#current-enrollment-body tr:not(.empty-row)').length, 3, 'current enrollment updated');\n    assert(document.querySelector('#plan-table-body .empty-row'), 'plan empty state');\n    document.querySelector('#modal-actions [data-modal-close]').click();\n    console.log('PASS registration flow');\n  }\n\n  {\n    const dom = await load('profile.html');\n    const { document, window, localStorage } = dom.window;\n    assert.strictEqual(document.querySelectorAll('#profile-course-body tr:not(.empty-row)').length, 2, 'profile enrollment rows');\n    assert.strictEqual(document.querySelector('#stat-courses').textContent, '2', 'profile course stat');\n    assert.strictEqual(document.querySelector('#stat-credits').textContent, '6', 'profile credit stat');\n    const drop = document.querySelector('[data-drop-course]');\n    click(window, drop);\n    assert.strictEqual(document.querySelectorAll('#profile-course-body tr:not(.empty-row)').length, 1, 'drop updates rows');\n    assert.strictEqual(document.querySelector('#stat-credits').textContent, '3', 'drop updates credits');\n    assert.strictEqual(JSON.parse(localStorage.getItem('prism_registered_v1')).length, 1, 'drop persists');\n    console.log('PASS profile interactions');\n  }\n\n  {\n    const dom = await load('index.html');\n    const { document, window } = dom.window;\n    const toggle = document.querySelector('#nav-toggle');\n    const nav = document.querySelector('#primary-nav');\n    click(window, toggle);\n    assert(nav.classList.contains('is-open'), 'mobile nav opens');\n    assert.strictEqual(toggle.getAttribute('aria-expanded'), 'true', 'aria-expanded true');\n    window.innerWidth = 500;\n    window.dispatchEvent(new window.Event('resize'));\n    click(window, toggle);\n    assert(!nav.classList.contains('is-open'), 'mobile nav closes');\n    console.log('PASS responsive navigation');\n  }\n\n  if (errors.length) {\n    console.error('ERRORS:', errors);\n    process.exitCode = 1;\n  } else {\n    console.log('PASS no console errors');\n  }\n})().catch((error) => {\n  console.error(error);\n  if (errors.length) console.error('Captured errors:', errors);\n  process.exit(1);\n});\nEOF" action.permission=* action.action=allow action.pattern=*
