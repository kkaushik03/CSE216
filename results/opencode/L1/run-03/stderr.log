timestamp=2026-10-30T00:50:46.970Z level=INFO run=04919fa4 message=evaluated permission=bash pattern="cat > /home/node/tmpdom/test.js <<'EOF'\nconst { JSDOM, VirtualConsole } = require('/home/node/tmpdom/node_modules/jsdom');\n\nconst BASE = 'http://127.0.0.1:8765/';\nconst failures = [];\n\nfunction wait(ms) { return new Promise(r => setTimeout(r, ms)); }\nfunction check(name, cond, detail) {\n  if (cond) console.log('PASS', name);\n  else { failures.push(name + (detail ? ' :: ' + detail : '')); console.log('FAIL', name, detail || ''); }\n}\n\nasync function load(page, setup) {\n  const errors = [];\n  const vc = new VirtualConsole();\n  vc.on('jsdomError', e => errors.push('jsdomError: ' + e.message));\n  vc.on('error', (...args) => errors.push('console.error: ' + args.join(' ')));\n  const dom = await JSDOM.fromURL(BASE + page, {\n    runScripts: 'dangerously',\n    resources: 'usable',\n    pretendToBeVisual: true,\n    virtualConsole: vc,\n    beforeParse(window) {\n      window.HTMLElement.prototype.scrollIntoView = function () {};\n      window.addEventListener('error', e => errors.push('window error: ' + e.message));\n      if (setup) setup(window);\n    }\n  });\n  await new Promise(resolve => dom.window.addEventListener('load', resolve, { once: true }));\n  await wait(150);\n  return { dom, window: dom.window, document: dom.window.document, errors };\n}\n\n(async () => {\n  // Home\n  {\n    const { window, document, errors } = await load('index.html');\n    check('home: no console errors', errors.length === 0, errors.join(' | '));\n    check('home: 6 featured cards', document.querySelectorAll('#featured-grid .course-card').length === 6, String(document.querySelectorAll('#featured-grid .course-card').length));\n    check('home: 9 departments', document.querySelectorAll('#dept-grid .dept-card').length === 9, String(document.querySelectorAll('#dept-grid .dept-card').length));\n    check('home: stats courses = 15', document.querySelector('#stat-courses').textContent === '15', document.querySelector('#stat-courses').textContent);\n    check('home: nav has 4 links', document.querySelectorAll('#primary-nav a').length === 4);\n    check('home: active nav home', document.querySelector('[data-nav=\"home\"]').classList.contains('is-active'));\n    window.close();\n  }\n\n  // Catalog\n  {\n    const { window, document, errors } = await load('catalog.html');\n    check('catalog: no console errors', errors.length === 0, errors.join(' | '));\n    check('catalog: 15 cards', document.querySelectorAll('#course-grid .course-card').length === 15, String(document.querySelectorAll('#course-grid .course-card').length));\n    check('catalog: result count', document.querySelector('#results-count').textContent.includes('15'));\n    const search = document.querySelector('#course-search');\n    search.value = 'web';\n    search.dispatchEvent(new window.Event('input', { bubbles: true }));\n    await wait(30);\n    check('catalog: search web -> 1 card', document.querySelectorAll('#course-grid .course-card').length === 1, String(document.querySelectorAll('#course-grid .course-card').length));\n    check('catalog: search counts', document.querySelector('#results-count').textContent.includes('1'));\n    document.querySelector('#filter-dept').value = 'Design';\n    document.querySelector('#filter-dept').dispatchEvent(new window.Event('change', { bubbles: true }));\n    await wait(30);\n    check('catalog: combined filters empty', document.querySelectorAll('#course-grid .course-card').length === 0 && !document.querySelector('#empty-state').hidden);\n    document.querySelector('#reset-filters').click();\n    await wait(30);\n    check('catalog: reset -> 15 cards', document.querySelectorAll('#course-grid .course-card').length === 15, String(document.querySelectorAll('#course-grid .course-card').length));\n    document.querySelector('#filter-dept').value = 'Design';\n    document.querySelector('#filter-dept').dispatchEvent(new window.Event('change', { bubbles: true }));\n    await wait(30);\n    check('catalog: Design -> 2 cards', document.querySelectorAll('#course-grid .course-card').length === 2, String(document.querySelectorAll('#course-grid .course-card').length));\n    window.close();\n  }\n\n  // Catalog with dept URL\n  {\n    const { window, document, errors } = await load('catalog.html?dept=Psychology');\n    check('catalog dept param: filters to Psychology', document.querySelectorAll('#course-grid .course-card').length === 2, String(document.querySelectorAll('#course-grid .course-card').length));\n    check('catalog dept param: no errors', errors.length === 0, errors.join(' | '));\n    window.close();\n  }\n\n  // Register: form validation, modal, confirm\n  {\n    const { window, document, errors } = await load('register.html?course=cs-340');\n    check('register: no console errors', errors.length === 0, errors.join(' | '));\n    check('register: course preselected', document.querySelector('#courseId').value === 'cs-340');\n    check('register: preview shows course', document.querySelector('#course-preview').textContent.includes('Web Development'));\n    check('register: empty table', document.querySelectorAll('#registrations-body tr.empty-row').length === 1);\n\n    const form = document.querySelector('#registration-form');\n    form.dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\n    await wait(40);\n    check('register: empty submit shows errors', document.querySelectorAll('.field-error').length > 0 && document.querySelectorAll('[data-error-for]:not(:empty)').length >= 2, String(document.querySelectorAll('[data-error-for]:not(:empty)').length));\n\n    document.querySelector('#fullName').value = 'Alex Morgan';\n    document.querySelector('#studentId').value = '20261234';\n    document.querySelector('#email').value = 'alex.morgan@university.edu';\n    document.querySelector('#courseId').value = 'cs-340';\n    document.querySelector('#courseId').dispatchEvent(new window.Event('change', { bubbles: true }));\n    form.dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\n    await wait(50);\n    check('register: confirmation modal opens', !!document.querySelector('.modal-overlay'));\n    check('register: modal mentions course', document.querySelector('.modal-body').textContent.includes('CS 340'));\n\n    document.querySelector('[data-modal-confirm]').click();\n    await wait(350);\n    check('register: modal closed', !document.querySelector('.modal-overlay'));\n    check('register: one registered row', document.querySelectorAll('#registrations-body tr[data-reg-id]').length === 1, String(document.querySelectorAll('#registrations-body tr[data-reg-id]').length));\n    check('register: success banner visible', !document.querySelector('#success-banner').hidden);\n    check('register: nav badge shows 1', document.querySelector('.js-reg-count').textContent === '1' && !document.querySelector('.js-reg-count').hidden);\n    check('register: stored in localStorage', JSON.parse(window.localStorage.getItem('uniflow.registrations')).length === 1);\n    check('register: profile saved', !!window.localStorage.getItem('uniflow.profile'));\n\n    const removeBtn = document.querySelector('.js-remove-registration');\n    removeBtn.click();\n    await wait(50);\n    check('register: remove modal opens', !!document.querySelector('.modal-overlay'));\n    document.querySelector('[data-modal-confirm]').click();\n    await wait(350);\n    check('register: row removed', document.querySelectorAll('#registrations-body tr[data-reg-id]').length === 0);\n    check('register: empty state after remove', !!document.querySelector('#registrations-body tr.empty-row'));\n    check('register: no errors after interactions', errors.length === 0, errors.join(' | '));\n    window.close();\n  }\n\n  // Profile seeded\n  {\n    const seedRegs = [{ id: 'r1', courseId: 'cs-340', semester: 'Fall 2026', studentName: 'Alex Morgan', studentId: '20261234', email: 'alex.morgan@university.edu', createdAt: new Date().toISOString() }];\n    const seedProfile = { name: 'Alex Morgan', studentId: '20261234', email: 'alex.morgan@university.edu', program: 'Computer Science', year: 'Second year' };\n    const { window, document, errors } = await load('profile.html', w => {\n      w.localStorage.setItem('uniflow.registrations', JSON.stringify(seedRegs));\n      w.localStorage.setItem('uniflow.profile', JSON.stringify(seedProfile));\n    });\n    check('profile: no console errors', errors.length === 0, errors.join(' | '));\n    check('profile: name shown', document.querySelector('#profile-name').textContent === 'Alex Morgan');\n    check('profile: stats count 1', document.querySelector('#stat-my-courses').textContent === '1');\n    check('profile: credits count 3', document.querySelector('#stat-my-credits').textContent === '3');\n    check('profile: one row', document.querySelectorAll('#profile-registrations-body tr[data-reg-id]').length === 1);\n    document.querySelector('#edit-profile-btn').click();\n    await wait(50);\n    check('profile: edit form opens', !document.querySelector('#profile-form').hidden);\n    document.querySelector('#profileProgram').value = 'Design';\n    document.querySelector('#profile-form').dispatchEvent(new window.Event('submit', { bubbles: true, cancelable: true }));\n    await wait(50);\n    check('profile: form closes after save', document.querySelector('#profile-form').hidden);\n    check('profile: program updated', document.querySelector('#profile-program').textContent === 'Design', document.querySelector('#profile-program').textContent);\n    check('profile: saved program', JSON.parse(window.localStorage.getItem('uniflow.profile')).program === 'Design');\n    check('profile: no errors after edit', errors.length === 0, errors.join(' | '));\n    window.close();\n  }\n\n  // Profile empty\n  {\n    const { window, document, errors } = await load('profile.html');\n    check('profile empty: guest name', document.querySelector('#profile-name').textContent === 'Guest Student');\n    check('profile empty: empty table row', !!document.querySelector('#profile-registrations-body tr.empty-row'));\n    check('profile empty: no errors', errors.length === 0, errors.join(' | '));\n    window.close();\n  }\n\n  console.log('\\n' + (failures.length ? 'FAILURES:\\n' + failures.join('\\n') : 'ALL TESTS PASSED'));\n  process.exit(failures.length ? 1 : 0);\n})().catch(err => { console.error(err); process.exit(1); });\nEOF" action.permission=* action.action=allow action.pattern=*
