timestamp=2026-10-30T01:11:10.118Z level=INFO run=b8b11d28 message=evaluated permission=bash pattern="python3 - <<'PY'\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nfrom urllib.parse import urlparse\nclass L(HTMLParser):\n    def __init__(self): super().__init__(); self.links=[]; self.ids=set()\n    def handle_starttag(self,tag,attrs):\n        d=dict(attrs)\n        if 'id' in d: self.ids.add(d['id'])\n        if tag in ('a','link','script') and ('href' in d or 'src' in d):\n            self.links.append(d.get('href') or d.get('src'))\nfiles={p.name:p for p in Path('.').glob('*.html')}\nfor name,p in files.items():\n    l=L(); l.feed(p.read_text())\n    for link in l.links:\n        if link.startswith(('http','mailto:','data:')): continue\n        u=urlparse(link)\n        target=u.path or name\n        if target not in files:\n            print(name,'MISSING FILE',link)\n        elif u.fragment:\n            t=L(); t.feed(files[target].read_text())\n            if u.fragment not in t.ids:\n                print(name,'MISSING ANCHOR',link)\nprint('link check done')\nPY" action.permission=* action.action=allow action.pattern=*
