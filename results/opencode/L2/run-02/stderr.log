timestamp=2026-10-30T01:09:39.614Z level=INFO run=b8b11d28 message=evaluated permission=bash pattern="cat > /tmp/app-test/axe-states.js <<'JS'\nconst http=require('http'),fs=require('fs'),path=require('path');\nconst {JSDOM,VirtualConsole}=require('jsdom');\nconst axeSource=fs.readFileSync(require.resolve('axe-core/axe.min.js'),'utf8');\nconst root='/work';const types={'.html':'text/html','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml'};\nconst server=http.createServer((req,res)=>{const u=decodeURIComponent(req.url.split('?')[0]);const f=path.join(root,u==='/'?'index.html':u);if(!f.startsWith(root)||!fs.existsSync(f)){res.writeHead(404);res.end();return;}res.writeHead(200,{'Content-Type':types[path.extname(f)]||'application/octet-stream'});fs.createReadStream(f).pipe(res);});\nasync function load(page){const vc=new VirtualConsole();const dom=await JSDOM.fromURL('http://127.0.0.1:8896/'+page,{runScripts:'dangerously',resources:'usable',pretendToBeVisual:true,virtualConsole:vc});await new Promise(r=>dom.window.addEventListener('load',()=>setTimeout(r,100)));return dom;}\nasync function run(dom,label){\n const {window}=dom;window.eval(axeSource);\n const results=await window.axe.run(window.document,{rules:{'color-contrast':{enabled:false}}});\n console.log('\\nSTATE',label,'violations',results.violations.length);\n for(const v of results.violations){console.log('-',v.id,v.help); for(const n of v.nodes.slice(0,3)) console.log('  ',n.target.join(' '),'::',n.failureSummary.replace(/\\n/g,' | ').slice(0,260));}\n}\n(async()=>{\n await new Promise(r=>server.listen(8896,'127.0.0.1',r));\n let dom=await load('registration.html');\n let w=dom.window,d=w.document;\n await run(dom,'registration initial');\n d.querySelector('#fullName').value='';\n d.querySelector('#registration-form').dispatchEvent(new w.Event('submit',{bubbles:true,cancelable:true}));\n await run(dom,'registration errors');\n w.close();\n dom=await load('registration.html'); w=dom.window;d=w.document;\n d.querySelector('#course-select').value='fil260';\n d.querySelector('#registration-form').dispatchEvent(new w.Event('submit',{bubbles:true,cancelable:true}));\n await new Promise(r=>setTimeout(r,50));\n await run(dom,'registration modal');\n w.close();\n dom=await load('profile.html'); w=dom.window;d=w.document;\n d.querySelector('#edit-profile-btn').click();\n await run(dom,'profile edit');\n w.close();\n server.close();\n})().catch(e=>{console.error(e);server.close();process.exit(1);});\nJS" action.permission=* action.action=allow action.pattern=*
