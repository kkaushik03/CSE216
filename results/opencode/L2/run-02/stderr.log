timestamp=2026-10-30T01:05:38.161Z level=INFO run=b8b11d28 message=evaluated permission=bash pattern="cat > /tmp/app-test/fulltest.js <<'JS'\nconst http = require('http');\nconst fs = require('fs');\nconst path = require('path');\nconst { JSDOM, VirtualConsole } = require('jsdom');\n\nconst root = '/work';\nconst types = {'.html':'text/html','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml'};\nconst server = http.createServer((req,res)=>{\n  const urlPath = decodeURIComponent(req.url.split('?')[0]);\n  const file = path.join(root, urlPath === '/' ? 'index.html' : urlPath);\n  if (!file.startsWith(root) || !fs.existsSync(file)) { res.writeHead(404); res.end('not found'); return; }\n  res.writeHead(200, {'Content-Type': types[path.extname(file)] || 'application/octet-stream'});\n  fs.createReadStream(file).pipe(res);\n});\n\nfunction waitLoad(dom) {\n  return new Promise((resolve, reject) => {\n    const t = setTimeout(() => reject(new Error('load timeout')), 5000);\n    dom.window.addEventListener('load', () => { clearTimeout(t); setTimeout(resolve, 80); });\n  });\n}\n\nasync function load(page) {\n  const errors = [];\n  const vc = new VirtualConsole();\n  vc.on('jsdomError', e => errors.push('jsdomError: ' + e.message));\n  vc.on('error', (...args) => errors.push('console.error: ' + args.join(' ')));\n  const dom = await JSDOM.fromURL(`http://127.0.0.1:8899/${page}`, {\n    runScripts: 'dangerously', resources: 'usable', pretendToBeVisual: true, virtualConsole: vc\n  });\n  await waitLoad(dom);\n  return { dom, doc: dom.window.document, win: dom.window, errors };\n}\n\nfunction assert(cond, msg) { if (!cond) throw new Error('ASSERT: ' + msg); }\n\n(async () => {\n  await new Promise(r => server.listen(8899, '127.0.0.1', r));\n\n  {\n    const { dom, doc, win, errors } = await load('index.html');\n    assert(errors.length === 0, 'index errors ' + errors.join('; '));\n    assert(doc.querySelectorAll('.course-card').length === 4, 'featured cards');\n    assert(doc.querySelectorAll('#primary-nav a[aria-current=\"page\"]').length === 1, 'current page nav');\n    const toggle = doc.querySelector('.nav-toggle');\n    toggle.click();\n    assert(toggle.getAttribute('aria-expanded') === 'true', 'nav opens');\n    assert(doc.querySelector('#primary-nav').classList.contains('is-open'), 'nav class');\n    toggle.click();\n    assert(toggle.getAttribute('aria-expanded') === 'false', 'nav closes');\n    assert(doc.querySelector('[data-course-count]').textContent === '16', 'course count');\n    console.log('PASS home');\n    win.close();\n  }\n\n  {\n    const { dom, doc, win, errors } = await load('catalog.html?q=climate');\n    assert(errors.length === 0, 'catalog errors ' + errors.join('; '));\n    assert(doc.querySelectorAll('#course-list .course-card').length === 1, 'climate search one');\n    assert(doc.querySelector('#results-count').textContent.includes('1 of 16'), 'search count');\n    const search = doc.querySelector('#catalog-search');\n    search.value = '';\n    search.dispatchEvent(new win.Event('input', {bubbles:true}));\n    assert(doc.querySelectorAll('#course-list .course-card').length === 16, 'clear search shows all');\n    const dept = doc.querySelector('#department-filter');\n    dept.value = 'Design';\n    dept.dispatchEvent(new win.Event('change', {bubbles:true}));\n    assert(doc.querySelectorAll('#course-list .course-card').length === 2, 'design filter');\n    assert(doc.querySelectorAll('#course-list .course-card .course-card__header .course-code')[0].textContent === 'DES 120', 'design sort featured');\n    const level = doc.querySelector('#level-filter');\n    level.value = '300';\n    level.dispatchEvent(new win.Event('change', {bubbles:true}));\n    assert(doc.querySelectorAll('#course-list .course-card').length === 0, 'empty filtered');\n    assert(doc.querySelector('#empty-state').hidden === false, 'empty state visible');\n    doc.querySelector('#empty-reset').click();\n    assert(doc.querySelectorAll('#course-list .course-card').length === 16, 'reset filters');\n    const sort = doc.querySelector('#sort-filter');\n    sort.value = 'seats';\n    sort.dispatchEvent(new win.Event('change', {bubbles:true}));\n    const firstSeats = doc.querySelector('#course-list .course-card .seat-status').textContent;\n    assert(firstSeats.includes('30'), 'sort by seats first is 30 left, got ' + firstSeats);\n    console.log('PASS catalog');\n    win.close();\n  }\n\n  {\n    const { dom, doc, win, errors } = await load('registration.html?course=fil260');\n    assert(errors.length === 0, 'registration errors ' + errors.join('; '));\n    assert(doc.querySelectorAll('#course-select option').length === 17, 'course options');\n    assert(doc.querySelector('#course-select').value === 'fil260', 'query preselect');\n    assert(doc.querySelector('#fullName').value === 'Alex Morgan', 'profile prefill');\n    assert(doc.querySelectorAll('#registered-courses-body tr').length === 2, 'default rows');\n    assert(doc.querySelector('#course-summary').textContent.includes('Documentary Practice'), 'summary selected');\n\n    const form = doc.querySelector('#registration-form');\n    form.querySelector('#semester').value = 'Spring 2027';\n    form.dispatchEvent(new win.Event('submit', {bubbles:true, cancelable:true}));\n    assert(doc.querySelector('#confirmation-modal').hidden === false, 'modal open');\n    assert(doc.querySelectorAll('#registered-courses-body tr').length === 3, 'table after register');\n    assert(doc.querySelector('[data-registration-count]').textContent === '3 courses', 'count after register');\n    assert(doc.querySelector('#confirmation-course').textContent.includes('FIL 260'), 'modal course');\n    assert(win.localStorage.getItem('campusCourseHub.registrations.v1').includes('fil260'), 'stored registration');\n\n    doc.querySelector('#modal-close').click();\n    assert(doc.querySelector('#confirmation-modal').hidden === true, 'modal closed');\n\n    const select = doc.querySelector('#course-select');\n    select.value = 'fil260';\n    select.dispatchEvent(new win.Event('change', {bubbles:true}));\n    form.dispatchEvent(new win.Event('submit', {bubbles:true, cancelable:true}));\n    assert(doc.querySelector('#registration-errors').hidden === false, 'duplicate error summary');\n    assert(doc.querySelector('#courseId-error').hidden === false, 'duplicate inline error');\n    assert(doc.querySelector('#course-select').getAttribute('aria-invalid') === 'true', 'duplicate aria invalid');\n\n    const drop = doc.querySelector('button[data-drop-course=\"fil260\"]');\n    drop.click();\n    assert(doc.querySelectorAll('#registered-courses-body tr').length === 2, 'table after drop');\n    assert(doc.querySelector('#app-toast').hidden === false, 'toast visible');\n    doc.querySelector('.toast-undo').click();\n    assert(doc.querySelectorAll('#registered-courses-body tr').length === 3, 'undo restores');\n    console.log('PASS registration flow');\n    win.close();\n  }\n\n  {\n    const { dom, doc, win, errors } = await load('profile.html');\n    assert(errors.length === 0, 'profile errors ' + errors.join('; '));\n    assert(doc.querySelector('#profile-display-name').textContent === 'Alex Morgan', 'profile name');\n    assert(doc.querySelector('#profile-hero-name').textContent === 'Alex', 'hero first name');\n    assert(doc.querySelector('[data-stat-courses]').textContent === '2', 'stat courses');\n    assert(doc.querySelector('[data-stat-credits]').textContent === '6', 'stat credits');\n    assert(doc.querySelector('[data-stat-departments]').textContent === '2', 'stat departments');\n    assert(doc.querySelectorAll('#registered-courses-body tr').length === 2, 'profile rows');\n\n    doc.querySelector('#edit-profile-btn').click();\n    assert(doc.querySelector('#profile-edit-form').hidden === false, 'edit form visible');\n    assert(doc.activeElement.id === 'profile-name-input', 'focus first profile input');\n    const nameInput = doc.querySelector('#profile-name-input');\n    nameInput.value = 'Jamie Rivera';\n    doc.querySelector('#profile-edit-form').dispatchEvent(new win.Event('submit', {bubbles:true, cancelable:true}));\n    assert(doc.querySelector('#profile-display-name').textContent === 'Jamie Rivera', 'profile updated');\n    assert(doc.querySelector('#profile-avatar').textContent === 'JR', 'avatar initials');\n    assert(doc.querySelector('#profile-edit-form').hidden === true, 'edit form closed');\n    assert(win.localStorage.getItem('campusCourseHub.profile.v1').includes('Jamie Rivera'), 'stored profile');\n    console.log('PASS profile');\n    win.close();\n  }\n\n  server.close();\n  console.log('\\nALL TESTS PASSED');\n})().catch(async (e) => {\n  console.error(e.stack || e);\n  server.close();\n  process.exit(1);\n});\nJS" action.permission=* action.action=allow action.pattern=*
