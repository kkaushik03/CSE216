timestamp=2026-10-30T01:08:02.116Z level=INFO run=b8b11d28 message=evaluated permission=bash pattern="cat > /tmp/app-test/shot.js <<'JS'\nconst { chromium } = require('playwright');\nconst http = require('http');\nconst fs = require('fs');\nconst path = require('path');\nconst root = '/work';\nconst types = {'.html':'text/html','.css':'text/css','.js':'text/javascript','.svg':'image/svg+xml'};\nconst server = http.createServer((req,res)=>{\n  const urlPath = decodeURIComponent(req.url.split('?')[0]);\n  const file = path.join(root, urlPath === '/' ? 'index.html' : urlPath);\n  if (!file.startsWith(root) || !fs.existsSync(file)) { res.writeHead(404); res.end('not found'); return; }\n  res.writeHead(200, {'Content-Type': types[path.extname(file)] || 'application/octet-stream'});\n  fs.createReadStream(file).pipe(res);\n});\n(async()=>{\n  await new Promise(r=>server.listen(8898,'127.0.0.1',r));\n  const browser = await chromium.launch({headless:true});\n  const pages = ['index.html','catalog.html','registration.html','profile.html'];\n  const errors = [];\n  for (const p of pages) {\n    const context = await browser.newContext({viewport:{width:1440,height:1000}, deviceScaleFactor:1});\n    const page = await context.newPage();\n    page.on('console', msg => { if (msg.type()==='error') errors.push(p+' console: '+msg.text()); });\n    page.on('pageerror', err => errors.push(p+' pageerror: '+err.message));\n    await page.goto('http://127.0.0.1:8898/'+p, {waitUntil:'networkidle'});\n    await page.screenshot({path:'/tmp/app-test/'+p.replace('.html','')+'-desktop.png', fullPage:true});\n    console.log(p, 'desktop scrollWidth/height', await page.evaluate(()=>({w:document.documentElement.scrollWidth,h:document.documentElement.scrollHeight, vw:innerWidth, vh:innerHeight})));\n    if (p==='catalog.html') {\n      await page.fill('#catalog-search','design');\n      await page.selectOption('#department-filter','Design');\n      await page.screenshot({path:'/tmp/app-test/catalog-filtered.png', fullPage:true});\n    }\n    if (p==='registration.html') {\n      await page.selectOption('#course-select','fil260');\n      await page.fill('#semester','Spring 2027');\n      await page.click('#registration-form button[type=\"submit\"]');\n      await page.waitForTimeout(300);\n      await page.screenshot({path:'/tmp/app-test/registration-modal.png', fullPage:false});\n      await page.click('#modal-close');\n      await page.screenshot({path:'/tmp/app-test/registration-after.png', fullPage:true});\n    }\n    await context.close();\n\n    const mctx = await browser.newContext({viewport:{width:390,height:844}, deviceScaleFactor:1, isMobile:true, hasTouch:true});\n    const mp = await mctx.newPage();\n    mp.on('console', msg => { if (msg.type()==='error') errors.push(p+' mobile console: '+msg.text()); });\n    mp.on('pageerror', err => errors.push(p+' mobile pageerror: '+err.message));\n    await mp.goto('http://127.0.0.1:8898/'+p, {waitUntil:'networkidle'});\n    if (p==='index.html') await mp.click('.nav-toggle');\n    await mp.screenshot({path:'/tmp/app-test/'+p.replace('.html','')+'-mobile.png', fullPage:true});\n    console.log(p, 'mobile scrollWidth/height', await mp.evaluate(()=>({w:document.documentElement.scrollWidth,h:document.documentElement.scrollHeight, vw:innerWidth, vh:innerHeight})));\n    await mctx.close();\n  }\n  console.log('ERRORS', errors.length ? errors : 'none');\n  await browser.close();\n  server.close();\n})().catch(e=>{console.error(e); server.close(); process.exit(1);});\nJS" action.permission=* action.action=allow action.pattern=*
