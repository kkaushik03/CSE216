timestamp=2026-10-30T01:08:12.289Z level=INFO run=b8b11d28 message=evaluated permission=bash pattern="python3 - <<'PY'\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nfrom collections import Counter\nclass P(HTMLParser):\n    def __init__(self):\n        super().__init__(convert_charrefs=True)\n        self.ids=[]; self.refs=[]; self.labels=[]; self.controls=[]; self.headings=[]; self.imgs=[]; self.inputs=[]; self.buttons=[]; self.forms=[]; self.tables=[]\n    def handle_starttag(self, tag, attrs):\n        d=dict(attrs)\n        if 'id' in d: self.ids.append(d['id'])\n        for k in ['aria-labelledby','aria-describedby','aria-controls']:\n            if k in d:\n                for i in d[k].split(): self.refs.append((tag,k,i))\n        if tag=='label' and 'for' in d: self.labels.append(d['for'])\n        if tag in ('input','select','textarea') and 'id' in d: self.controls.append(d['id'])\n        if tag in ('h1','h2','h3','h4','h5','h6'): self.headings.append((tag,d.get('id'),d))\n        if tag=='img': self.imgs.append(d)\n        if tag in ('input','select','textarea'): self.inputs.append((tag,d))\n        if tag=='button': self.buttons.append(d)\n        if tag=='form': self.forms.append(d)\n        if tag=='table': self.tables.append(d)\nfor f in Path('.').glob('*.html'):\n    p=P(); p.feed(f.read_text())\n    dup=[i for i,c in Counter(p.ids).items() if c>1]\n    missing=[r for r in p.refs if r[2] not in p.ids]\n    label_missing=[l for l in p.labels if l not in p.ids]\n    inputs_no_id=[(t,d) for t,d in p.inputs if 'id' not in d and d.get('type') not in ('hidden','submit')]\n    h1=[h for h in p.headings if h[0]=='h1']\n    print('\\n',f)\n    print(' dup ids',dup)\n    print(' missing aria refs',missing)\n    print(' label for missing',label_missing)\n    print(' inputs no id',inputs_no_id)\n    print(' h1 count',len(h1))\n    print(' buttons no type',[b for b in p.buttons if 'type' not in b])\n    print(' forms',p.forms,'tables',p.tables)\nPY" action.permission=* action.action=allow action.pattern=*
