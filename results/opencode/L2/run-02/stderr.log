timestamp=2026-10-30T01:08:38.097Z level=INFO run=b8b11d28 message=evaluated permission=bash pattern="python3 - <<'PY'\nfrom pathlib import Path\n# index: remove dl aria-label\np=Path('index.html'); s=p.read_text(); s=s.replace('<dl class=\"hero-stats\" aria-label=\"Course catalog at a glance\">','<dl class=\"hero-stats\">'); p.write_text(s)\n# profile: outer aria, hidden heading, section table\np=Path('profile.html'); s=p.read_text(); s=s.replace('<section class=\"section section--profile\" aria-labelledby=\"profile-display-name\">','<section class=\"section section--profile\">')\ns=s.replace('          <div id=\"profile-view\">\\n            <dl class=\"profile-details\" aria-label=\"Student information\">','          <div id=\"profile-view\">\\n            <h3 class=\"sr-only\">Student information</h3>\\n            <dl class=\"profile-details\">')\ns=s.replace('<div class=\"table-scroll\" role=\"region\" aria-label=\"Registered courses table\" tabindex=\"0\">','<section class=\"table-scroll\" aria-label=\"Registered courses table\" tabindex=\"0\">')\ns=s.replace('          </div>\\n          <p class=\"table-note\">Course changes are saved in this browser for this demo.</p>','          </section>\\n          <p class=\"table-note\">Course changes are saved in this browser for this demo.</p>')\np.write_text(s)\n# registration: outer aria, table section\np=Path('registration.html'); s=p.read_text(); s=s.replace('<section class=\"section section--registration\" aria-labelledby=\"form-section-heading\">','<section class=\"section section--registration\">')\ns=s.replace('<div class=\"table-scroll\" role=\"region\" aria-label=\"Registered courses table\" tabindex=\"0\">','<section class=\"table-scroll\" aria-label=\"Registered courses table\" tabindex=\"0\">')\ns=s.replace('          </div>\\n          <p class=\"table-note\">Need to explore more options?','          </section>\\n          <p class=\"table-note\">Need to explore more options?')\np.write_text(s)\n# catalog: add submit button in search\np=Path('catalog.html'); s=p.read_text()\nold='''                <input id=\"catalog-search\" name=\"q\" type=\"search\" placeholder=\"Search by course, code, department, or instructor\" autocomplete=\"off\">\n              </div>'''\nnew='''                <input id=\"catalog-search\" name=\"q\" type=\"search\" placeholder=\"Search by course, code, department, or instructor\" autocomplete=\"off\">\n                <button class=\"btn btn-primary search-submit\" type=\"submit\">Search</button>\n              </div>'''\nif old not in s: raise SystemExit('catalog search snippet not found')\ns=s.replace(old,new)\np.write_text(s)\nprint('patched html')\nPY" action.permission=* action.action=allow action.pattern=*
