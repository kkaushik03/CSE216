timestamp=2026-10-30T01:11:26.865Z level=INFO run=b8b11d28 message=evaluated permission=bash pattern="python3 - <<'PY'\ndef lum(h):\n    h=h.lstrip('#'); r,g,b=[int(h[i:i+2],16)/255 for i in (0,2,4)]\n    def f(c): return c/12.92 if c<=.04045 else ((c+.055)/1.055)**2.4\n    return .2126*f(r)+.7152*f(g)+.0722*f(b)\ndef cr(a,b):\n    l1,l2=sorted([lum(a),lum(b)],reverse=True); return (l1+.05)/(l2+.05)\nthemes={\n'violet':('#4524bb','#efe9ff'),'teal':('#05655b','#e0f7f3'),'amber':('#7a3c00','#fff2d6'),'coral':('#9e2326','#ffe7e4'),'pink':('#8c1150','#ffe6f2'),'blue':('#1747ab','#e6efff'),'emerald':('#125f3e','#e1f7eb'),'orange':('#913806','#ffeddf'),'rose':('#8e1f45','#ffe5eb'),'indigo':('#333399','#e9e9ff'),'cyan':('#065a72','#e0f7fc'),'purple':('#55198a','#f3e7ff'),'fuchsia':('#84148e','#fce7ff'),'lime':('#3d6209','#eef9d8'),'sky':('#02527d','#e0f2fe')}\nfor k,(a,b) in themes.items(): print(k,round(cr(a,b),2))\nPY" action.permission=* action.action=allow action.pattern=*
