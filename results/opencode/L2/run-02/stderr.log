pQuery.addListener(handleDesktopChange);\n      }\n    }\n''')\nold='''    if (departmentSelect && departmentSelect.querySelector('option[value=\"' + state.department.replace(/\"/g, '\\\\\\\\\"') + '\"]')) {\n      departmentSelect.value = state.department;\n    } else {\n      state.department = \"all\";\n    }\n    if (levelSelect && levelSelect.querySelector('option[value=\"' + state.level + '\"]')) {\n      levelSelect.value = state.level;\n    } else {\n      state.level = \"all\";\n    }\n    if (formatSelect && formatSelect.querySelector('option[value=\"' + state.format.replace(/\"/g, '\\\\\\\\\"') + '\"]')) {\n      formatSelect.value = state.format;\n    } else {\n      state.format = \"all\";\n    }\n    if (sortSelect && sortSelect.querySelector('option[value=\"' + state.sort + '\"]')) {\n      sortSelect.value = state.sort;\n    } else {\n      state.sort = \"featured\";\n    }\n'''\nnew='''    function hasOption(select, value) {\n      return Boolean(select) && Array.from(select.options).some(function (option) {\n        return option.value === value;\n      });\n    }\n\n    if (hasOption(departmentSelect, state.department)) {\n      departmentSelect.value = state.department;\n    } else {\n      state.department = \"all\";\n    }\n    if (hasOption(levelSelect, state.level)) {\n      levelSelect.value = state.level;\n    } else {\n      state.level = \"all\";\n    }\n    if (hasOption(formatSelect, state.format)) {\n      formatSelect.value = state.format;\n    } else {\n      state.format = \"all\";\n    }\n    if (hasOption(sortSelect, state.sort)) {\n      sortSelect.value = state.sort;\n    } else {\n      state.sort = \"featured\";\n    }\n'''\nif old not in s:\n    raise SystemExit('old not found')\ns=s.replace(old,new)\np.write_text(s)\nprint('patched')\nPY" action.permission=* action.action=allow action.pattern=*
