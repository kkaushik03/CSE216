timestamp=2026-10-30T01:02:12.707Z level=INFO run=b8b11d28 message=evaluated permission=bash pattern="python3 - <<'PY'\nfrom html.parser import HTMLParser\nfrom pathlib import Path\nclass P(HTMLParser):\n    def __init__(self):\n        super().__init__(convert_charrefs=True)\n        self.stack=[]\n        self.errors=[]\n        self.void={'area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr'}\n    def handle_starttag(self, tag, attrs):\n        if tag not in self.void:\n            self.stack.append(tag)\n    def handle_endtag(self, tag):\n        if tag in self.void: return\n        if not self.stack:\n            self.errors.append(f'extra closing {tag}')\n        elif self.stack[-1]!=tag:\n            if tag in self.stack:\n                self.errors.append(f'unexpected closing {tag}, open stack tail {self.stack[-5:]}')\n                while self.stack and self.stack[-1]!=tag: self.stack.pop()\n                if self.stack: self.stack.pop()\n            else:\n                self.errors.append(f'closing {tag} without open')\n        else:\n            self.stack.pop()\nfor f in Path('.').glob('*.html'):\n    p=P(); p.feed(f.read_text())\n    print(f, 'stack', p.stack, 'errors', p.errors[:10])\nPY" action.permission=* action.action=allow action.pattern=*
