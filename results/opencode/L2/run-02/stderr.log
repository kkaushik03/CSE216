timestamp=2026-10-30T01:11:22.628Z level=INFO run=b8b11d28 message=evaluated permission=bash pattern="python3 - <<'PY'\ndef lum(h):\n    h=h.lstrip('#'); r,g,b=[int(h[i:i+2],16)/255 for i in (0,2,4)]\n    def f(c): return c/12.92 if c<=.04045 else ((c+.055)/1.055)**2.4\n    return .2126*f(r)+.7152*f(g)+.0722*f(b)\ndef cr(a,b):\n    l1,l2=sorted([lum(a),lum(b)],reverse=True); return (l1+.05)/(l2+.05)\npairs=[\n('ink on paper','#211c3a','#fff9f2'),('muted on paper','#675f7d','#fff9f2'),('muted on white','#675f7d','#ffffff'),('muted on fcfaf7','#675f7d','#fcfaf7'),\n('coral kicker on paper','#c42f32','#fff9f2'),('brand dark on white','#4524bb','#ffffff'),('brand dark on brand soft','#4524bb','#efe9ff'),\n('placeholder on white','#6f6782','#ffffff'),('footer text','#b8afce','#1b172b'),('footer bottom','#a79dbf','#1b172b'),('footer link','#d9d3e8','#1b172b'),\n('white on ink','#ffffff','#211c3a'),('white on violet','#ffffff','#5b36e9'),('white on pink','#ffffff','#b31968'),('white on teal','#ffffff','#087f72'),('white on amber','#ffffff','#9a4c00'),('white on coral','#ffffff','#c42f32'),('white on blue','#ffffff','#1d5bd8'),('white on emerald','#ffffff','#18794e'),('white on orange','#ffffff','#b8480a'),('white on rose','#ffffff','#b42a59'),('white on indigo','#ffffff','#3f3fb0'),('white on cyan','#ffffff','#08718f'),('white on purple','#ffffff','#6b21a8'),('white on fuchsia','#ffffff','#a21caf'),('white on lime','#ffffff','#4d7c0f'),('white on sky','#ffffff','#0369a1'),\n('ink on cream','#211c3a','#f7eee6'),('danger on danger soft','#a8232c','#ffebed'),('success on success soft','#166a45','#e2f7eb'),('dept muted white','#675f7d','#fff'),\n]\nfor name,a,b in pairs:\n    print(f'{name:40s} {cr(a,b):.2f}')\nPY" action.permission=* action.action=allow action.pattern=*
