timestamp=2026-10-30T01:36:46.805Z level=INFO run=bda1f3eb message=evaluated permission=bash pattern="cat > /home/node/pwtest/finaltest.js <<'EOF'\nconst { chromium } = require('playwright');\n(async()=>{\n const browser=await chromium.launch();\n const ctx=await browser.newContext({viewport:{width:1440,height:1000}});\n const page=await ctx.newPage();\n const errors=[]; page.on('pageerror',e=>errors.push('pageerror: '+e.message)); page.on('console',m=>{if(m.type()==='error') errors.push('console: '+m.text())});\n const base='http://127.0.0.1:4173/';\n await page.goto(base); await page.waitForTimeout(300);\n console.log('home cards', await page.locator('.course-card').count(), 'badge', await page.locator('.nav-badge').first().textContent());\n // all pages 200-ish via nav\n const nav=page.getByRole('navigation',{name:'Primary navigation'});\n for (const name of ['Courses','Registration','Profile','Home']) {\n  const link=nav.getByRole('link',{name:new RegExp('^'+name)});\n  await link.click(); await page.waitForLoadState('load');\n  console.log(name, await page.locator('h1').first().textContent(), await page.locator('.skip-link').count());\n }\n // search from home\n await page.fill('#home-search','robotics'); await page.press('#home-search','Enter'); await page.waitForTimeout(300);\n console.log('empty summary', await page.locator('#results-summary').textContent(), 'empty', await page.locator('#no-results').isVisible());\n await page.click('#empty-reset'); await page.waitForTimeout(100);\n const before=await page.locator('.course-card').count();\n await page.selectOption('#department-filter','Design'); await page.waitForTimeout(100);\n console.log('design filter', await page.locator('.course-card').count(), 'of', before);\n await page.selectOption('#level-filter','300'); await page.waitForTimeout(100);\n console.log('design300', await page.locator('#results-summary').textContent());\n await page.click('#clear-filters');\n // registration\n await page.goto(base+'registration.html'); await page.waitForTimeout(200);\n const initialRows=await page.locator('#schedule-body tr').count();\n console.log('initial rows',initialRows);\n // submit empty gives errors incl course/agreement\n await page.click('button[type=submit]'); await page.waitForTimeout(100);\n console.log('errors', await page.locator('.field-error:not(:empty)').count(), 'summary', await page.locator('#form-error-summary').isVisible());\n // select course and check\n await page.selectOption('#course-select','psy-265'); await page.check('#reg-agreement');\n await page.click('button[type=submit]'); await page.waitForTimeout(200);\n console.log('modal open/focus', await page.locator('#confirm-dialog').evaluate(el=>el.open), await page.evaluate(()=>document.activeElement.id));\n // cancel via go back\n await page.getByRole('button',{name:'Go back'}).click(); await page.waitForTimeout(100);\n console.log('modal canceled', await page.locator('#confirm-dialog').evaluate(el=>el.open), 'focus', await page.evaluate(()=>document.activeElement.textContent.trim().slice(0,30)));\n // reopen confirm\n await page.click('button[type=submit]'); await page.waitForTimeout(100);\n await page.click('#confirm-action'); await page.waitForTimeout(200);\n console.log('rows after add', await page.locator('#schedule-body tr').count(), 'status', (await page.locator('#registration-status').textContent()).slice(0,50));\n // drop the new course by label\n const dropButtons=page.locator('[data-drop-course]');\n console.log('drop buttons', await dropButtons.count());\n await dropButtons.last().click(); await page.waitForTimeout(100);\n console.log('drop title', await page.locator('#confirm-title').textContent());\n await page.click('#confirm-action'); await page.waitForTimeout(200);\n console.log('rows after drop', await page.locator('#schedule-body tr').count(), 'status', (await page.locator('#registration-status').textContent()).slice(0,50));\n // profile update then persist back registration prefill\n await page.goto(base+'profile.html'); await page.waitForTimeout(200);\n await page.fill('#profile-full-name','Maya Thompson'); await page.click('#profile-form button[type=submit]'); await page.waitForTimeout(100);\n console.log('profile status', await page.locator('#profile-status').textContent());\n await page.goto(base+'registration.html'); await page.waitForTimeout(200);\n console.log('prefilled name', await page.inputValue('#reg-name'));\n // widths mobile\n await page.setViewportSize({width:390,height:844});\n for (const f of ['index.html','courses.html','registration.html','profile.html']) {\n  await page.goto(base+f); await page.waitForTimeout(200);\n  console.log(f, 'scroll', await page.evaluate(()=>document.documentElement.scrollWidth));\n }\n console.log('ERRORS', errors);\n await browser.close();\n})();\nEOF" action.permission=* action.action=allow action.pattern=*
