timestamp=2026-10-30T01:19:55.935Z level=INFO run=bda1f3eb message=evaluated permission=bash pattern="cat > /home/node/pwtest/test.js <<'EOF'\nconst { chromium } = require('playwright');\n(async () => {\n  const browser = await chromium.launch({headless:true});\n  const context = await browser.newContext({viewport:{width:1440,height:1100}});\n  const page = await context.newPage();\n  const errors = [];\n  page.on('console', m => { if (m.type() === 'error') errors.push('console: '+m.text()); });\n  page.on('pageerror', e => errors.push('pageerror: '+e.message));\n  const base = 'http://127.0.0.1:4173/';\n  await page.goto(base+'index.html');\n  await page.waitForTimeout(500);\n  await page.screenshot({path:'/home/node/pwtest/home.png', fullPage:true});\n  console.log('home title', await page.title(), 'cards', await page.locator('.course-card').count());\n  console.log('nav count', await page.locator('.nav-badge').textContent());\n  // nav all pages\n  for (const [label,file] of [['Courses','courses.html'],['Registration','registration.html'],['Profile','profile.html']]) {\n    await page.getByRole('navigation', {name:'Primary navigation'}).getByRole('link',{name: new RegExp('^'+label)}).click();\n    await page.waitForLoadState('load');\n    console.log(label,'url', page.url().split('/').pop(), 'h1', await page.locator('h1').first().textContent());\n  }\n  await page.screenshot({path:'/home/node/pwtest/profile.png', fullPage:true});\n  // back to courses\n  await page.goto(base+'courses.html');\n  await page.waitForTimeout(200);\n  console.log('catalog cards', await page.locator('.course-card').count());\n  await page.screenshot({path:'/home/node/pwtest/courses.png', fullPage:true});\n  // search\n  await page.fill('#course-search','climate');\n  await page.waitForTimeout(100);\n  console.log('search summary', await page.locator('#results-summary').textContent(), 'cards', await page.locator('.course-card').count());\n  await page.selectOption('#department-filter','Computer Science');\n  await page.waitForTimeout(100);\n  console.log('combined summary', await page.locator('#results-summary').textContent());\n  console.log('empty shown', await page.locator('#no-results').isVisible());\n  await page.screenshot({path:'/home/node/pwtest/courses-empty.png', fullPage:true});\n  await page.click('#empty-reset');\n  console.log('reset cards', await page.locator('.course-card').count());\n  // registration page direct requested course\n  await page.goto(base+'registration.html?course=env-150');\n  await page.waitForTimeout(200);\n  console.log('selected course', await page.inputValue('#course-select'));\n  console.log('table rows', await page.locator('#schedule-body tr').count());\n  await page.screenshot({path:'/home/node/pwtest/registration.png', fullPage:true});\n  // submit without agreement => validation\n  await page.click('button[type=submit]');\n  console.log('summary visible', await page.locator('#form-error-summary').isVisible(), 'errors', await page.locator('.field-error:not(:empty)').count());\n  await page.screenshot({path:'/home/node/pwtest/registration-error.png', fullPage:true});\n  await page.check('#reg-agreement');\n  await page.click('button[type=submit]');\n  console.log('dialog open', await page.locator('#confirm-dialog').evaluate(el=>el.open));\n  await page.screenshot({path:'/home/node/pwtest/modal.png', fullPage:true});\n  await page.click('#confirm-action');\n  await page.waitForTimeout(200);\n  console.log('after register rows', await page.locator('#schedule-body tr').count(), 'status', await page.locator('#registration-status').textContent());\n  console.log('nav count after', await page.locator('.nav-badge').textContent());\n  await page.screenshot({path:'/home/node/pwtest/registration-success.png', fullPage:true});\n  // drop first course\n  await page.locator('[data-drop-course]').first().click();\n  console.log('drop dialog title', await page.locator('#confirm-title').textContent());\n  await page.screenshot({path:'/home/node/pwtest/drop-modal.png', fullPage:true});\n  await page.click('#confirm-action');\n  await page.waitForTimeout(200);\n  console.log('after drop rows', await page.locator('#schedule-body tr').count());\n  // profile persistence\n  await page.goto(base+'profile.html');\n  await page.waitForTimeout(200);\n  console.log('profile rows', await page.locator('#profile-schedule-body tr').count(), 'in progress', await page.locator('.stat-card--teal dd').textContent());\n  await page.fill('#profile-full-name','Maya T. Thompson');\n  await page.click('#profile-form button[type=submit]');\n  console.log('profile status', await page.locator('#profile-status').textContent(), 'banner', await page.locator('#profile-name').textContent());\n  await page.screenshot({path:'/home/node/pwtest/profile-updated.png', fullPage:true});\n  // mobile screenshots\n  const mobile = await context.newPage();\n  await mobile.setViewportSize({width:390,height:844});\n  await mobile.goto(base+'courses.html');\n  await mobile.waitForTimeout(200);\n  await mobile.screenshot({path:'/home/node/pwtest/mobile-courses.png', fullPage:true});\n  await mobile.goto(base+'registration.html');\n  await mobile.waitForTimeout(200);\n  await mobile.screenshot({path:'/home/node/pwtest/mobile-registration.png', fullPage:true});\n  console.log('ERRORS', JSON.stringify(errors, null, 2));\n  await browser.close();\n})();\nEOF" action.permission=* action.action=allow action.pattern=*
